---
import { resolveLocale, getNavLinks, getLocaleLinks, getDict, route } from '@/i18n';
import { routePath } from '@lib/paths';

const locale = resolveLocale(Astro.currentLocale);
const navLinks = getNavLinks(locale);
const dict = getDict(locale);
const currentPath = routePath(Astro.url);

// Schimbătorul de limbă: toate cele trei limbi, fiecare cu traducerea paginii
// curente (sau indexul secțiunii, când pagina nu are pereche 1:1).
const localeLinks = getLocaleLinks(currentPath, locale);
const contactHref = route('contact', locale);
const homeHref = route('home', locale);
const themeLabel = dict.header.themeToggle;
---

<header
  id="site-header"
  class="fixed top-0 z-50 w-full border-b border-transparent transition-[background-color,border-color,box-shadow] duration-300"
>
  <div class="container flex h-16 items-center justify-between md:h-[4.5rem]">
    <!-- Logo -->
    <a href={homeHref} class="group flex items-center gap-2.5" style="view-transition-name: site-logo;">
      <span class="grid size-8 place-items-center rounded-lg bg-primary-600 font-heading text-sm font-black text-white shadow-soft transition-transform duration-300 group-hover:rotate-[-6deg]">
        B
      </span>
      <span class="font-heading text-lg font-black tracking-tight text-ink">Ban Studio</span>
    </a>

    <!-- Navigare desktop -->
    <nav class="hidden items-center gap-0.5 md:flex" aria-label={dict.header.mainNav}>
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'relative rounded-md px-3 py-2 text-sm font-medium transition-colors',
            currentPath.startsWith(link.href)
              ? 'text-primary-600'
              : 'text-ink-muted hover:text-ink',
          ]}
          aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}

      <div class="mx-2 h-5 w-px bg-border" aria-hidden="true"></div>

      <!-- Theme toggle -->
      <button
        type="button"
        id="theme-toggle"
        class="grid size-9 place-items-center rounded-md text-ink-muted transition-colors hover:bg-surface-2 hover:text-ink"
        aria-label={themeLabel}
        title={themeLabel}
      >
        <svg class="size-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" /></svg>
        <svg class="hidden size-5 dark:block" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" /></svg>
      </button>

      <!-- Language switcher -->
      <details class="lang-switch relative" data-lang-switch>
        <summary
          class="ml-0.5 inline-flex cursor-pointer list-none items-center gap-1.5 rounded-md px-2.5 py-1.5 text-xs font-semibold text-ink-subtle transition-colors hover:text-ink"
          aria-label={dict.header.language}
          title={dict.header.language}
        >
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A8.966 8.966 0 0 1 3 12c0-1.97.633-3.792 1.708-5.274" /></svg>
          {locale.toUpperCase()}
          <svg class="lang-chevron size-3 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
        </summary>
        <ul class="absolute right-0 top-full z-50 mt-2 min-w-[9.5rem] overflow-hidden rounded-lg border border-border bg-surface py-1 shadow-medium">
          {localeLinks.map((l) => (
            <li>
              <a
                href={l.href}
                lang={l.locale}
                hreflang={l.locale}
                aria-current={l.current ? 'true' : undefined}
                class:list={[
                  'flex items-center justify-between gap-3 px-3 py-2 text-sm transition-colors',
                  l.current
                    ? 'font-semibold text-primary-600 dark:text-primary-300'
                    : 'text-ink-muted hover:bg-surface-2 hover:text-ink',
                ]}
              >
                <span>{l.name}</span>
                <span class="font-mono text-[0.7rem] uppercase text-ink-subtle">{l.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>

      <a
        href={contactHref}
        class="ml-1.5 inline-flex items-center rounded-lg bg-ink px-4 py-2 text-sm font-semibold text-surface transition-transform duration-200 hover:-translate-y-0.5"
      >
        {dict.nav.cta}
      </a>
    </nav>

    <!-- Mobile: theme + lang + hamburger -->
    <div class="flex items-center gap-1 md:hidden">
      <button
        type="button"
        id="theme-toggle-mobile"
        class="grid size-9 place-items-center rounded-md text-ink-muted transition-colors hover:bg-surface-2"
        aria-label={themeLabel}
      >
        <svg class="size-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" /></svg>
        <svg class="hidden size-5 dark:block" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" /></svg>
      </button>
      <details class="lang-switch relative" data-lang-switch>
        <summary
          class="inline-flex cursor-pointer list-none items-center gap-1 rounded-md px-2 py-1.5 text-xs font-semibold text-ink-subtle transition-colors hover:text-ink"
          aria-label={dict.header.language}
          title={dict.header.language}
        >
          <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A8.966 8.966 0 0 1 3 12c0-1.97.633-3.792 1.708-5.274" /></svg>
          {locale.toUpperCase()}
          <svg class="lang-chevron size-3 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
        </summary>
        <ul class="absolute right-0 top-full z-50 mt-2 min-w-[9.5rem] overflow-hidden rounded-lg border border-border bg-surface py-1 shadow-medium">
          {localeLinks.map((l) => (
            <li>
              <a
                href={l.href}
                lang={l.locale}
                hreflang={l.locale}
                aria-current={l.current ? 'true' : undefined}
                class:list={[
                  'flex items-center justify-between gap-3 px-3 py-2 text-sm transition-colors',
                  l.current
                    ? 'font-semibold text-primary-600 dark:text-primary-300'
                    : 'text-ink-muted hover:bg-surface-2 hover:text-ink',
                ]}
              >
                <span>{l.name}</span>
                <span class="font-mono text-[0.7rem] uppercase text-ink-subtle">{l.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
      <button
        type="button"
        id="menu-toggle"
        class="grid size-10 place-items-center rounded-lg text-ink transition-colors hover:bg-surface-2"
        aria-label={dict.header.menuOpen}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open" class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6.75h16.5" /></svg>
        <svg id="icon-close" class="hidden size-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
      </button>
    </div>
  </div>

  <!-- Meniu mobil -->
  <nav id="mobile-menu" class="hidden border-t border-border bg-surface md:hidden">
    <div class="container flex flex-col gap-1 py-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'rounded-lg px-3 py-2.5 text-base font-medium transition-colors',
            currentPath.startsWith(link.href)
              ? 'bg-primary-500/10 text-primary-600'
              : 'text-ink-muted hover:bg-surface-2 hover:text-ink',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href={contactHref}
        class="mt-2 inline-flex items-center justify-center rounded-lg bg-ink px-4 py-2.5 text-base font-semibold text-surface"
      >
        {dict.nav.cta}
      </a>
    </div>
  </nav>
</header>

<div class="h-16 md:h-[4.5rem]" aria-hidden="true"></div>

<script>
  // Meniu mobil
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const iconOpen = document.getElementById('icon-open')!;
  const iconClose = document.getElementById('icon-close')!;
  toggle.addEventListener('click', () => {
    const isOpen = menu.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
    iconOpen.classList.toggle('hidden');
    iconClose.classList.toggle('hidden');
  });

  // Header scroll-aware
  const header = document.getElementById('site-header')!;
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Theme toggle (auto + manual, persistat în localStorage)
  function applyTheme(theme: string | null) {
    if (theme === 'dark' || theme === 'light') {
      document.documentElement.dataset.theme = theme;
    } else {
      delete document.documentElement.dataset.theme;
    }
  }
  function currentResolved() {
    const set = document.documentElement.dataset.theme;
    if (set === 'dark' || set === 'light') return set;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }
  function toggleTheme() {
    const next = currentResolved() === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem('theme', next); } catch (e) {}
    applyTheme(next);
  }
  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);

  // Schimbătorul de limbă (<details>): închide la click în afară sau Escape.
  const langSwitches = () =>
    document.querySelectorAll<HTMLDetailsElement>('details[data-lang-switch][open]');
  document.addEventListener('click', (e) => {
    langSwitches().forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') langSwitches().forEach((d) => { d.open = false; });
  });
</script>

<style>
  #site-header.is-scrolled {
    background-color: color-mix(in oklch, var(--color-surface) 80%, transparent);
    backdrop-filter: blur(12px) saturate(1.4);
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-soft);
  }
  /* dark:hidden controlat manual prin data-theme — neutralizăm utilitarul Tailwind dark: */

  /* Schimbătorul de limbă — dropdown nativ pe <details>, zero JS pentru deschidere */
  .lang-switch > summary { list-style: none; }
  .lang-switch > summary::-webkit-details-marker { display: none; }
  .lang-switch > summary::marker { content: ""; }
  .lang-switch[open] > summary { color: var(--color-ink); }
  .lang-switch[open] .lang-chevron { transform: rotate(180deg); }
</style>
