---
/** Pagina „Creare site web": proiecte din Chișinău + întrebări frecvente (cu FAQPage). Text în src/lib/web-dev-content.ts. */
import Section from '@components/ui/Section.astro';
import ProjectCard from '@components/ui/ProjectCard.astro';
import SchemaFAQ from '@components/seo/SchemaFAQ.astro';
import { getCollection } from 'astro:content';
import { resolveLocale, route } from '@/i18n';
import { WEB_DEV_CONTENT } from '@lib/web-dev-content';

const locale = resolveLocale(Astro.currentLocale);
const { projects, faq } = WEB_DEV_CONTENT[locale];
const portfolio = route('portfolio', locale);
const suffix = { ro: '', ru: '-ru', en: '-en' }[locale];

const entries = await getCollection('portofoliu');
const shown = projects.slugs
  .map((slug) => entries.find((e) => e.id === `${slug}${suffix}`))
  .filter((e) => e !== undefined);
---

<Section>
  <h2 class="title-tech">{projects.title}</h2>
  <p class="mt-4 max-w-2xl text-ink-muted">{projects.subtitle}</p>
  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {shown.map((p) => (
      <ProjectCard
        href={`${portfolio}/${p.id}`}
        image={p.data.image}
        imageAlt={p.data.imageAlt}
        title={p.data.title}
        client={p.data.client}
        tags={p.data.tags}
      />
    ))}
  </div>
</Section>

<Section background="muted" dots>
  <SchemaFAQ items={faq.items} />
  <h2 class="title-tech text-center">{faq.title}</h2>
  <div class="faq-panel brackets mx-auto mt-10 max-w-3xl divide-y divide-border">
    {faq.items.map((f) => (
      <details class="faq reveal py-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-lg font-bold text-ink">
          {f.q}
          <svg class="faq-chevron size-5 shrink-0 text-ink-subtle transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </summary>
        <p class="mt-3 text-ink-muted">{f.a}</p>
      </details>
    ))}
  </div>
</Section>

<style>
  /* Aceleași stiluri ca FAQ-ul de pe home (src/pages/index.astro). */
  .faq-panel {
    border: 1px solid var(--color-border);
    background: color-mix(in oklch, var(--color-surface-3) 60%, transparent);
    padding-inline: clamp(1.25rem, 3vw, 2.25rem);
    text-align: left;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq[open] .faq-chevron { transform: rotate(180deg); }
</style>
