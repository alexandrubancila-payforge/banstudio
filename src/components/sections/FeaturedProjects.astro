---
import SectionHeading from '@components/ui/SectionHeading.astro';
import Badge from '@components/ui/Badge.astro';
import Button from '@components/ui/Button.astro';
import { getCollection } from 'astro:content';
import { resolveLocale, getDict, route } from '@/i18n';

const locale = resolveLocale(Astro.currentLocale);
const dict = getDict(locale);
const portfolioHref = route('portfolio', locale);

const featured = (await getCollection('portofoliu'))
  .filter((p) => p.data.featured && (p.data.lang === locale || (!p.data.lang && locale === 'ro')))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
---

{featured.length > 0 && (
  <div>
    <SectionHeading
      title={dict.portfolio.title}
      subtitle={dict.portfolio.subtitle}
    />

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((project) => (
        <a
          href={`${portfolioHref}/${project.id}`}
          class="group reveal overflow-hidden rounded-2xl border border-border bg-surface-3 transition-[transform,border-color,box-shadow] duration-300 hover:-translate-y-1 hover:border-primary-400 hover:shadow-medium"
        >
          <div class="aspect-video overflow-hidden bg-surface-2">
            <img
              src={project.data.image}
              alt={project.data.imageAlt}
              width="720"
              height="378"
              decoding="async"
              class="size-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.04]"
              loading="lazy"
            />
          </div>
          <div class="p-5">
            <div class="flex flex-wrap gap-2">
              {project.data.tags.slice(0, 2).map((tag) => (
                <Badge>{tag}</Badge>
              ))}
            </div>
            <h3 class="mt-3 font-heading text-lg font-bold text-ink transition-colors group-hover:text-primary-600 dark:group-hover:text-primary-300">
              {project.data.title}
            </h3>
            <p class="mt-1 text-sm text-ink-subtle">
              {project.data.client}
            </p>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-10 text-center">
      <Button href={portfolioHref} variant="secondary">
        {dict.portfolio.viewAll} →
      </Button>
    </div>
  </div>
)}
