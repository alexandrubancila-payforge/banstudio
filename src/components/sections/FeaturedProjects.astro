---
/**
 * Proiecte recente — cu ierarhie, nu grilă uniformă: primul proiect (cel cu
 * `order` cel mai mic — WishDrop, produsul propriu) primește un card mare pe
 * toată lățimea, cu imagine și descriere; restul vin în grilă dedesubt.
 * Tag-urile stau pe imagine, ca pastile translucide, iar corpul cardului rămâne
 * doar titlu + client — mai puțin zgomot pe fiecare card.
 */
import SectionHeading from '@components/ui/SectionHeading.astro';
import Button from '@components/ui/Button.astro';
import ProjectCard from '@components/ui/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { resolveLocale, getDict, route } from '@/i18n';

const locale = resolveLocale(Astro.currentLocale);
const dict = getDict(locale);
const portfolioHref = route('portfolio', locale);

const featured = (await getCollection('portofoliu'))
  .filter((p) => p.data.featured && (p.data.lang === locale || (!p.data.lang && locale === 'ro')))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

// Patru carduri egale, nu unul mare + restul: în macheta cerută toate au
// aceeași greutate, iar rândul de patru se citește ca o vitrină.
const shown = featured.slice(0, 4);
---

{featured.length > 0 && (
  <div>
    <SectionHeading
      title={dict.portfolio.title}
      subtitle={dict.portfolio.subtitle}
    />

    <div class="fp">
      {shown.map((project) => (
        <a href={`${portfolioHref}/${project.id}`} class="fp-card reveal">
          <img
            src={project.data.image}
            alt={project.data.imageAlt}
            width="720"
            height="378"
            decoding="async"
            loading="lazy"
          />
          <span class="fp-scrim" aria-hidden="true"></span>
          {/* Doar eticheta mono a clientului, fără titlul mare: încărca cardul,
              iar proiectul se recunoaște oricum din captură — care conține
              logo-ul saitului. Numele complet rămâne în `alt`-ul imaginii, deci
              linkul își păstrează numele accesibil. */}
          <span class="fp-meta">
            <span class="fp-client">{project.data.client}</span>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-12 text-center">
      <Button href={portfolioHref} variant="secondary">
        {dict.portfolio.viewAll} →
      </Button>
    </div>
  </div>
)}

<style>
  /* Vitrină de patru carduri portret, cu numele peste imagine — macheta cerută.
     Capturile sunt însă PEISAJ (720×378): tăiate la portret s-ar vedea doar o
     felie verticală inutilizabilă. De-aia raportul e 4/5, nu 3/4, și
     `object-position: top` — așa în cadru intră exact partea de sus a fiecărui
     sait, adică headerul și hero-ul, partea cea mai recognoscibilă. */
  .fp {
    display: grid;
    gap: 0.9rem;
    margin-top: 2.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 64rem) {
    .fp { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .fp-card {
    position: relative;
    display: block;
    aspect-ratio: 5 / 6;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface-2);
  }
  .fp-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Ancorat STÂNGA-SUS, nu centru. Capturile sunt peisaj (1.9:1), iar într-un
       cadru portret `cover` arată doar ~44% din lățime — la centru nimerea
       mijlocul paginii, adică text tăiat pe jumătate. Din stânga-sus intră
       logo-ul, meniul și începutul hero-ului: partea după care recunoști saitul. */
    object-position: left top;
    transition: scale 1.1s var(--ease-out-expo);
  }
  .fp-card:hover img { scale: 1.04; }

  /* Scrim-ul nu e decor: numele e alb și stă peste captură, care jos poate fi
     orice culoare. Fără el contrastul ar depinde de poza fiecărui proiect. */
  .fp-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      oklch(0.08 0 0 / 0.94) 0%,
      oklch(0.08 0 0 / 0.72) 22%,
      oklch(0.08 0 0 / 0.28) 42%,
      transparent 66%
    );
  }
  .fp-meta {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .fp-client {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: oklch(1 0 0 / 0.88);
  }

  /* ---- ACORDEON LA HOVER (doar desktop cu mouse) ----
     Cardul atins se lățește, celelalte se strâng, iar descrierea lui apare.
     Cotele de `flex-grow` sunt 2.5 pentru cel deschis și 0.82 pentru restul:
     suma rămâne aproape constantă, deci rândul nu „respiră" pe lățime.

     Aici animăm `flex-grow`, adică LAYOUT la fiecare cadru — nu se poate altfel
     pentru un acordeon care împinge vecinii (referința face la fel). E limitat
     la patru elemente și doar cât ține cursorul deasupra.

     Înălțimea devine fixă, nu din `aspect-ratio`: altfel lățirea ar schimba și
     înălțimea, iar rândul ar sălta. */
  @media (min-width: 64rem) and (hover: hover) {
    .fp {
      display: flex;
      grid-template-columns: none;
    }
    .fp-card {
      flex: 1 1 0;
      min-width: 0;
      aspect-ratio: auto;
      height: clamp(21rem, 30vw, 28rem);
      transition: flex-grow 0.9s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .fp:hover .fp-card { flex-grow: 0.82; }
    .fp .fp-card:hover { flex-grow: 2.5; }
  }
</style>