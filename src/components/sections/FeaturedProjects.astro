---
/**
 * Proiecte recente — cu ierarhie, nu grilă uniformă: primul proiect (cel cu
 * `order` cel mai mic — WishDrop, produsul propriu) primește un card mare pe
 * toată lățimea, cu imagine și descriere; restul vin în grilă dedesubt.
 * Tag-urile stau pe imagine, ca pastile translucide, iar corpul cardului rămâne
 * doar titlu + client — mai puțin zgomot pe fiecare card.
 */
import SectionHeading from '@components/ui/SectionHeading.astro';
import Button from '@components/ui/Button.astro';
import ProjectCard from '@components/ui/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { resolveLocale, getDict, route } from '@/i18n';

const locale = resolveLocale(Astro.currentLocale);
const dict = getDict(locale);
const portfolioHref = route('portfolio', locale);

const featured = (await getCollection('portofoliu'))
  .filter((p) => p.data.featured && (p.data.lang === locale || (!p.data.lang && locale === 'ro')))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const hero = featured[0];
const rest = featured.slice(1);
---

{featured.length > 0 && (
  <div>
    <SectionHeading
      title={dict.portfolio.title}
      subtitle={dict.portfolio.subtitle}
    />

    <div class="fp">
      {hero && (
        <a href={`${portfolioHref}/${hero.id}`} class="fp-hero reveal">
          <span class="fp-hero-media">
            <img
              src={hero.data.image}
              alt={hero.data.imageAlt}
              width="720"
              height="378"
              decoding="async"
              loading="lazy"
            />
            <span class="fp-tags">
              {hero.data.tags.slice(0, 2).map((tag) => <span class="fp-tag">{tag}</span>)}
            </span>
          </span>
          <span class="fp-hero-body">
            <span class="fp-client spec">{hero.data.client}</span>
            <span class="fp-hero-title">{hero.data.title}</span>
            <span class="fp-hero-desc">{hero.data.description}</span>
            <span class="fp-more">
              {dict.services.learnMore}
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12l-7.5 7.5M3 12h18" />
              </svg>
            </span>
          </span>
        </a>
      )}

      {rest.map((project) => (
        <ProjectCard
          href={`${portfolioHref}/${project.id}`}
          image={project.data.image}
          imageAlt={project.data.imageAlt}
          title={project.data.title}
          client={project.data.client}
          tags={project.data.tags}
        />
      ))}
    </div>

    <div class="mt-12 text-center">
      <Button href={portfolioHref} variant="secondary">
        {dict.portfolio.viewAll} →
      </Button>
    </div>
  </div>
)}

<style>
  .fp {
    display: grid;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 48rem) {
    .fp { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64rem) {
    .fp { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* ---- cardul comun ---- */
  .fp-hero {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-2xl);
    border: 1px solid var(--color-border);
    background: var(--color-surface-3);
    box-shadow: var(--shadow-soft);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .fp-hero:hover {
    border-color: var(--color-primary-400);
    box-shadow: var(--shadow-medium);
  }

  /* ---- vedeta: pe toată lățimea, imagine + poveste ---- */
  .fp-hero { grid-column: 1 / -1; }
  @media (min-width: 64rem) {
    .fp-hero { flex-direction: row; }
    .fp-hero-media { flex: 1.2; }
    .fp-hero-body { flex: 1; }
  }
  .fp-hero-media {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--color-surface-2);
  }
  .fp-hero-media img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 15rem;
    object-fit: cover;
    transition: scale 0.6s var(--ease-out-expo);
  }
  .fp-hero:hover .fp-hero-media img { scale: 1.04; }
  .fp-hero-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.6rem;
    padding: clamp(1.5rem, 3vw, 2.75rem);
  }
  .fp-hero-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.35rem, 1.8vw, 1.7rem);
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--color-ink);
  }
  .fp-hero-desc {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .fp-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.6rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary-600);
  }
  :root[data-theme="dark"] .fp-more { color: var(--color-primary-300); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .fp-more { color: var(--color-primary-300); }
  }
  .fp-more svg { width: 1rem; height: 1rem; transition: translate 0.3s var(--ease-out-expo); }
  .fp-hero:hover .fp-more svg { translate: 0.25rem 0; }


  /* ---- tag-urile pe imagine ---- */
  .fp-tags {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: flex;
    gap: 0.35rem;
  }
  .fp-tag {
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    /* translucid deschis FIX: stă pe fotografii, nu pe suprafețele temei */
    background: oklch(0.99 0.003 150 / 0.88);
    backdrop-filter: blur(6px);
    border: 1px solid oklch(1 0 0 / 0.5);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.03em;
    color: oklch(0.3 0.01 160);
  }
</style>
