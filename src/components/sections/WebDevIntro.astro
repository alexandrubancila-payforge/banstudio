---
/** Pagina „Creare site web": introducere + tipuri de site cu prețuri. Text în src/lib/web-dev-content.ts. */
import Section from '@components/ui/Section.astro';
import Card from '@components/ui/Card.astro';
import { resolveLocale, route } from '@/i18n';
import { WEB_DEV_CONTENT, PRICING_ARTICLE } from '@lib/web-dev-content';

const locale = resolveLocale(Astro.currentLocale);
const { intro, types } = WEB_DEV_CONTENT[locale];
const portfolio = route('portfolio', locale);
const suffix = { ro: '', ru: '-ru', en: '-en' }[locale];
---

<Section>
  <h2 class="title-tech">{intro.title}</h2>
  <div class="mt-6 max-w-3xl space-y-4 text-lg text-ink-muted">
    {intro.paragraphs.map((p) => <p>{p}</p>)}
  </div>
</Section>

<Section background="muted" dots>
  <h2 class="title-tech">{types.title}</h2>
  <p class="mt-4 max-w-2xl text-ink-muted">{types.subtitle}</p>
  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {types.items.map((item) => (
      <Card class="reveal flex flex-col">
        <h3 class="font-heading text-lg font-bold text-ink">{item.name}</h3>
        <p class="mt-2 font-heading text-2xl font-black text-primary-600 dark:text-primary-300">{item.price}</p>
        <p class="mt-3 flex-1 text-sm text-ink-muted">{item.desc}</p>
        {item.example && (
          <a href={`${portfolio}/${item.example}${suffix}`} class="mt-4 text-sm font-semibold text-primary-600 transition-colors hover:text-primary-700 dark:text-primary-300">
            {types.exampleLabel} →
          </a>
        )}
        {item.service && (
          <a href={route(item.service, locale)} class="mt-4 text-sm font-semibold text-primary-600 transition-colors hover:text-primary-700 dark:text-primary-300">
            {types.serviceLabel} →
          </a>
        )}
      </Card>
    ))}
  </div>
  <p class="mt-8 max-w-3xl text-sm text-ink-muted">
    {types.note.before}<a href={PRICING_ARTICLE[locale]} class="font-semibold text-primary-600 underline underline-offset-4 dark:text-primary-300">{types.note.link}</a>{types.note.after}
  </p>
</Section>
