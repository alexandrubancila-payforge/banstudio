---
/**
 * ProfessionalService + WebSite pentru homepage (/, /ru, /en).
 * Aceeași entitate (același @id și url) pe toate trei; doar descrierea e în
 * limba paginii.
 * Email, telefon și profiluri = cele din footer (SOCIAL_LINKS / CONTACT din
 * src/lib/constants.ts), ca schema să nu se desincronizeze de pagină.
 */
import { SITE, SOCIAL_LINKS, CONTACT } from '@lib/constants';
import { resolveLocale, getSiteConfig, LOCALES, HREFLANG } from '@/i18n';

const locale = resolveLocale(Astro.currentLocale);
const site = getSiteConfig(locale);
const businessId = `${SITE.url}/#business`;

const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': businessId,
  name: SITE.name,
  url: `${SITE.url}/`,
  description: site.description,
  founder: {
    '@type': 'Person',
    name: site.author,
    jobTitle: 'Web Developer',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Chișinău',
    addressCountry: 'MD',
  },
  areaServed: [
    { '@type': 'City', name: 'Chișinău' },
    { '@type': 'Country', name: 'Moldova' },
    { '@type': 'Country', name: 'Romania' },
  ],
  serviceType: [
    'Web Development',
    'Web Design',
    'WordPress Development',
    'SEO',
    'Graphic Design',
    'Brand Identity',
  ],
  priceRange: '€€',
  email: CONTACT.email,
  telephone: CONTACT.phone,
  sameAs: [SOCIAL_LINKS.linkedin, SOCIAL_LINKS.github, SOCIAL_LINKS.telegram],
  image: `${SITE.url}/og-default.png`,
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: `${SITE.url}/`,
  inLanguage: LOCALES.map((l) => HREFLANG[l]),
  publisher: { '@id': businessId },
};
---

<script type="application/ld+json" set:html={JSON.stringify(business)} />
<script type="application/ld+json" set:html={JSON.stringify(website)} />
