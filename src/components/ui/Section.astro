---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
  background?: 'white' | 'muted';
  /** Șinele verticale care încadrează coloana de conținut. */
  rails?: boolean;
}

const { background = 'white', rails = true, class: className, ...rest } = Astro.props;

const backgrounds = {
  white: '',
  muted: 'bg-surface-2',
} as const;
---

<section
  class:list={['py-section', rails && 'rails', backgrounds[background], className]}
  {...rest}
>
  <div class="container">
    <slot />
  </div>
</section>
