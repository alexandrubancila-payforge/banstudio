---
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2' | 'h3';
}

const { title, subtitle, eyebrow, align = 'left', as: Tag = 'h2' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && (
    <span class:list={['eyebrow', align === 'center' && 'justify-center']}>{eyebrow}</span>
  )}
  <Tag class:list={['font-heading text-headline font-black text-ink', eyebrow && 'mt-4']}>
    {title}
  </Tag>
  {subtitle && (
    <p class="mt-4 text-lg text-ink-muted sm:text-xl">
      {subtitle}
    </p>
  )}
</div>
