---
/**
 * Cadran de performanță — semnătura paginii.
 * Instrument din lumea dezvoltatorului (scorul Lighthouse), bespoke:
 * arcul se desenează coral → emerald până la 100 la încărcare.
 * SVG + CSS pur, zero JS. Animația respectă prefers-reduced-motion.
 * Animăm DOAR stroke-dashoffset (arc) + transform (număr) — niciodată opacity,
 * ca să nu afectăm contrastul/LCP. Cutia e rezervată (aspect-square) → CLS 0.
 */
interface Props {
  label?: string;
  caption?: string;
}
const { label = 'Performance', caption = 'Lighthouse · banstudio.dev' } = Astro.props;
// r=92 → C = 2πr ≈ 578.05 ; arc 270° = 0.75·C ≈ 433.5 ; gap 90° la bază
const ARC = 433.5;
const GAP = 578.05;
---

<div class="gauge" role="img" aria-label={`Scor ${label} 100 din 100`}>
  <svg viewBox="0 0 220 220" aria-hidden="true">
    <defs>
      <linearGradient id="perf-grad" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0%" stop-color="oklch(0.66 0.20 30)" />
        <stop offset="45%" stop-color="oklch(0.80 0.16 75)" />
        <stop offset="100%" stop-color="oklch(0.55 0.17 155)" />
      </linearGradient>
    </defs>
    <!-- traseu -->
    <circle
      cx="110" cy="110" r="92"
      fill="none" stroke="var(--color-hairline)" stroke-width="14"
      stroke-linecap="round"
      stroke-dasharray={`${ARC} ${GAP}`}
      transform="rotate(135 110 110)"
    />
    <!-- arc valoare -->
    <circle
      class="gauge-arc"
      cx="110" cy="110" r="92"
      fill="none" stroke="url(#perf-grad)" stroke-width="14"
      stroke-linecap="round"
      stroke-dasharray={`${ARC} ${GAP}`}
      transform="rotate(135 110 110)"
    />
  </svg>
  <div class="gauge-center">
    <span class="gauge-score">100</span>
    <span class="gauge-label">{label}</span>
    <span class="gauge-caption spec">{caption}</span>
  </div>
</div>

<style define:vars={{ arc: ARC }}>
  .gauge {
    position: relative;
    width: min(22rem, 80vw);
    aspect-ratio: 1;
    margin-inline: auto;
  }
  .gauge svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
    filter: drop-shadow(0 8px 28px oklch(0.55 0.17 155 / 0.18));
  }
  .gauge-arc {
    stroke-dashoffset: 0; /* stare finală implicită (reduced-motion / no-JS) */
  }
  .gauge-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.15rem;
  }
  .gauge-score {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(3.5rem, 4vw + 2rem, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-ink);
    transform-origin: center;
  }
  .gauge-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-primary-600);
  }
  :global([data-theme="dark"]) .gauge-label { color: var(--color-primary-400); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .gauge-label { color: var(--color-primary-400); }
  }
  .gauge-caption {
    margin-top: 0.35rem;
    font-size: 0.7rem;
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: no-preference) {
    .gauge-arc {
      stroke-dashoffset: var(--arc);
      animation: gauge-sweep 1.5s var(--ease-out-expo) 0.15s forwards;
    }
    .gauge-score {
      animation: gauge-pop 0.7s var(--ease-spring) 0.9s backwards;
    }
  }
  @keyframes gauge-sweep {
    to { stroke-dashoffset: 0; }
  }
  @keyframes gauge-pop {
    from { transform: scale(0.82); }
    to { transform: scale(1); }
  }
</style>
