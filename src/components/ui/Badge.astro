---
interface Props {
  variant?: 'default' | 'primary' | 'accent';
}

const { variant = 'default' } = Astro.props;

const variants = {
  default: 'bg-surface-2 text-ink-muted border border-border',
  primary: 'bg-primary-500/12 text-primary-700 dark:text-primary-300',
  accent: 'bg-accent-500/15 text-accent-600 dark:text-accent-400',
} as const;
---

<span class:list={['inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold tracking-wide', variants[variant]]}>
  <slot />
</span>
