---
/**
 * Grilă de puncte care se dau la o parte din calea cursorului.
 *
 * DE CE CANVAS: efectul cerut nu e „se șterg", ci fiecare punct se deplasează
 * radial, iar cele împinse se adună într-un inel la marginea cercului. Asta e
 * matematică per punct — o mască CSS poate doar tăia, nu poate muta puncte
 * individual. (Prima încercare, cu două straturi mascate, chiar ștergea.)
 *
 * COST: grila statică se desenează O DATĂ, pe un canvas ascuns. La fiecare
 * cadru dăm blit din ea, golim discul de sub cursor și redesenăm doar punctele
 * din interiorul lui — circa 600 la o rază de 170px, nu cele ~13.000 din toată
 * secțiunea. Bucla rAF pornește doar cât timp cursorul e peste secțiune și se
 * oprește singură după ce punctele s-au așezat la loc.
 *
 * Fără cursor (telefoane) sau la `prefers-reduced-motion`, canvasul desenează
 * grila statică o singură dată și nu se atașează nimic — aceeași textură, zero
 * JS în execuție.
 */
---

<canvas class="dot-field" data-dot-field aria-hidden="true"></canvas>

<script>
  const TAU = Math.PI * 2;
  const STEP = 12;        // pasul grilei, în px CSS
  const DOT = 1;          // latura punctului
  const RADIUS = 105;     // raza zonei de influență
  const PUSH = 0.85;      // cât de tare împinge: la 0.85 discul se golește
                          // aproape complet și apare inelul de la margine

  const canHover = window.matchMedia('(hover: hover)').matches;
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-dot-field]')) {
    const host = canvas.parentElement;
    const ctx = canvas.getContext('2d');
    if (!ctx) continue;

    const off = document.createElement('canvas');
    const offCtx = off.getContext('2d');
    if (!offCtx) continue;

    let w = 0;
    let h = 0;
    let dpr = 1;
    let color = '#ccc';

    // cursorul: țintă + poziție interpolată, ca mișcarea să nu fie sacadată
    let tx = -9999;
    let ty = -9999;
    let cx = -9999;
    let cy = -9999;
    let target = 0;   // 1 cât timp cursorul e deasupra
    let power = 0;    // valoarea interpolată, dă intrarea/ieșirea moale
    let raf = 0;
    let visible = true;
    let prev = null;   // discul din cadrul precedent, ca să știm ce să reparăm

    function build() {
      const r = canvas.getBoundingClientRect();
      if (!r.width || !r.height) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = r.width;
      h = r.height;
      canvas.width = off.width = Math.round(w * dpr);
      canvas.height = off.height = Math.round(h * dpr);
      // Culoarea vine din CSS (`color` pe canvas), deci urmează tema fără
      // să fie scrisă de două ori.
      color = getComputedStyle(canvas).color;

      offCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
      offCtx.clearRect(0, 0, w, h);
      offCtx.fillStyle = color;
      for (let x = 0; x <= w; x += STEP) {
        for (let y = 0; y <= h; y += STEP) offCtx.fillRect(x, y, DOT, DOT);
      }
      // Canvasul a fost redimensionat, deci golit: discul precedent nu mai
      // corespunde nimicului de pe ecran, iar blitul trebuie să fie complet.
      prev = null;
      paint(true);
    }

    /* Repictăm DOAR regiunea schimbată — uniunea discului precedent cu cel
       curent — nu tot canvasul. Blitul întreg costa 8,2 ms pe cadru la
       2530×3098 px, adică jumătate din bugetul unui cadru de 60fps, și nu
       scădea deloc cu raza. Așa costul e proporțional cu discul. */
    function paint(full) {
      const R = RADIUS * power;
      const now = power > 0.004 ? { x: cx, y: cy, r: R } : null;

      ctx.setTransform(1, 0, 0, 1, 0, 0);
      if (full || (!prev && !now)) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(off, 0, 0);
      } else {
        const lo = [];
        const hi = [];
        for (const d of [prev, now]) {
          if (!d) continue;
          lo.push(d.x - d.r - 2, d.y - d.r - 2);
          hi.push(d.x + d.r + 2, d.y + d.r + 2);
        }
        const x0 = Math.max(0, Math.min(lo[0], lo[2] ?? lo[0]));
        const y0 = Math.max(0, Math.min(lo[1], lo[3] ?? lo[1]));
        const x1 = Math.min(w, Math.max(hi[0], hi[2] ?? hi[0]));
        const y1 = Math.min(h, Math.max(hi[1], hi[3] ?? hi[1]));
        const sx = Math.floor(x0 * dpr);
        const sy = Math.floor(y0 * dpr);
        const sw = Math.ceil((x1 - x0) * dpr);
        const sh = Math.ceil((y1 - y0) * dpr);
        if (sw > 0 && sh > 0) {
          ctx.clearRect(sx, sy, sw, sh);
          ctx.drawImage(off, sx, sy, sw, sh, sx, sy, sw, sh);
        }
      }
      prev = now;
      if (!now) return;

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, R, 0, TAU);
      ctx.clip();
      ctx.clearRect(cx - R, cy - R, R * 2, R * 2);
      ctx.fillStyle = color;

      // Doar punctele din disc. Deplasarea e radială: un punct la distanța d
      // ajunge la d + (R-d)*PUSH, deci toate cele din interior se strâng între
      // ~0.85R și R — exact golul cu inel de la margine.
      const i0 = Math.floor((cx - R) / STEP);
      const i1 = Math.ceil((cx + R) / STEP);
      const j0 = Math.floor((cy - R) / STEP);
      const j1 = Math.ceil((cy + R) / STEP);
      for (let i = i0; i <= i1; i++) {
        const x = i * STEP;
        for (let j = j0; j <= j1; j++) {
          const y = j * STEP;
          const dx = x - cx;
          const dy = y - cy;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d > R) continue;
          if (d < 0.001) continue;   // punctul exact sub cursor n-are direcție
          const k = (d + (R - d) * PUSH) / d;
          ctx.fillRect(cx + dx * k, cy + dy * k, DOT, DOT);
        }
      }
      ctx.restore();
    }

    function loop() {
      raf = 0;
      power += (target - power) * 0.18;
      cx += (tx - cx) * 0.22;
      cy += (ty - cy) * 0.22;
      paint();
      // Continuăm doar cât mai e ceva de animat; altfel bucla se oprește.
      const settling = Math.abs(target - power) > 0.004
        || (power > 0.004 && (Math.abs(tx - cx) > 0.5 || Math.abs(ty - cy) > 0.5));
      if (settling && visible) raf = requestAnimationFrame(loop);
      else if (!settling && target === 0) { power = 0; paint(true); }
    }

    function kick() {
      if (!raf && visible) raf = requestAnimationFrame(loop);
    }

    build();
    // `ResizeObserver`, nu `window.resize`: cutia se schimbă și când se
    // deschide un acordeon din secțiune sau când fonturile aterizează, fără
    // ca fereastra să fie redimensionată.
    if ('ResizeObserver' in window) {
      let rafBuild = 0;
      new ResizeObserver(() => {
        if (rafBuild) return;
        rafBuild = requestAnimationFrame(() => { rafBuild = 0; build(); });
      }).observe(canvas);
    } else {
      window.addEventListener('resize', build, { passive: true });
    }

    // Nu animăm secțiunile ieșite din ecran.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        visible = entries[0].isIntersecting;
        if (visible) kick();
      }, { rootMargin: '100px' }).observe(canvas);
    }

    // Tema schimbă culoarea punctelor — grila statică se reconstruiește.
    new MutationObserver(build).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    if (canHover && !calm && host) {
      host.addEventListener('pointermove', (e) => {
        const r = canvas.getBoundingClientRect();
        const nx = e.clientX - r.left;
        const ny = e.clientY - r.top;
        // La prima mișcare punem cursorul direct pe poziție, ca discul să nu
        // vină alunecând din colț.
        if (target === 0) { cx = nx; cy = ny; }
        tx = nx;
        ty = ny;
        target = 1;
        kick();
      }, { passive: true });

      host.addEventListener('pointerleave', () => {
        target = 0;
        kick();
      });
    }
  }
</script>

<style>
  .dot-field {
    position: absolute;
    inset: 0;
    /* OBLIGATORIU: canvasul e element înlocuit, iar `inset: 0` cu lățime `auto`
       NU îl întinde — rămâne la dimensiunea intrinsecă de 300×150. De-aia
       trebuie dimensiune explicită. */
    width: 100%;
    height: 100%;
    /* Aceeași cutie ca șinele: textura stă ÎN INTERIORUL cadrului, tăiată fix
       pe linia verticală. */
    max-width: var(--rail-frame);
    margin-inline: auto;
    clip-path: inset(0 calc(var(--container-padding) / 2));
    z-index: 0;
    pointer-events: none;
    /* Culoarea punctelor o citește scriptul din `color`, deci tema e sursa
       unică de adevăr. */
    color: var(--color-border-strong);
    opacity: 0.6;
    /* Stinge textura spre margini, ca înainte. */
    mask-image: radial-gradient(90% 80% at 50% 35%, black 10%, transparent 100%);
  }
</style>
