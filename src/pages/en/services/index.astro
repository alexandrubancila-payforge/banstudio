---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import CtaSplit from '@components/sections/CtaSplit.astro';
import { route } from '@/i18n';

const groups = [
  {
    label: 'Web development',
    services: [
      {
        title: 'Custom-coded website',
        description: 'Fast, SEO-optimised websites built with modern technologies. No templates — every project is unique.',
        href: route('services.web', 'en'),
        icon: 'M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5',
        features: ['Unique design, no templates', 'PageSpeed score of 100', 'Clean code — Astro / Next.js'],
      },
      {
        title: 'WordPress website',
        description: 'Professional WordPress websites with custom themes that you can manage yourself. No slow page builders.',
        href: route('services.wordpress', 'en'),
        icon: 'M3 8.25V18a2.25 2.25 0 0 0 2.25 2.25h13.5A2.25 2.25 0 0 0 21 18V8.25m-18 0V6a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 6v2.25m-18 0h18',
        features: ['Custom theme, no page builders', 'Easy to manage yourself', 'Fast and secure'],
      },
      {
        title: 'Website redesign',
        description: 'Turn an outdated website into one that is modern, fast and brings in clients. We keep what works and improve the rest.',
        href: route('services.redesign', 'en'),
        icon: 'M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.182 3.182a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99',
        features: ['A complete modernisation', 'We keep what works', 'Faster, more conversions'],
      },
    ],
  },
  {
    label: 'Design & brand',
    services: [
      {
        title: 'Business cards',
        description: 'Professional design that makes you memorable. Print-ready, delivered fast, several concepts to choose from.',
        href: route('services.cards', 'en'),
        icon: 'M6 6.878V6a2.25 2.25 0 0 1 2.25-2.25h7.5A2.25 2.25 0 0 1 18 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 0 0 4.5 9v.878m13.5-3A2.25 2.25 0 0 1 19.5 9v.878m0 0a2.246 2.246 0 0 0-.75-.128H5.25c-.263 0-.515.045-.75.128m15 0A2.25 2.25 0 0 1 21 12v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6c0-.98.626-1.813 1.5-2.122',
        features: ['Memorable design', 'Print-ready files', 'Several concepts'],
      },
      {
        title: 'Brand identity',
        description: 'Logo, colour palette, typography, brand guidelines — everything your brand needs to look coherent and professional.',
        href: route('services.brand', 'en'),
        icon: 'M4.098 19.902a3.75 3.75 0 0 0 5.304 0l6.401-6.402M6.75 21A3.75 3.75 0 0 1 3 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 0 0 3.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125H10.5',
        features: ['Logo + palette + typography', 'Brand guidelines', 'Consistency across channels'],
      },
    ],
  },
];
---

<BaseLayout
  title="Web services — website development, WordPress, redesign | Ban Studio"
  description="Professional web development and design services in Chisinau: website creation, WordPress, redesign, business cards, brand identity. Quote within 24 hours."
  heroOverlay
>
  <!-- Hero -->
  <section class="rails on-dark relative overflow-hidden">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="tech-grid" aria-hidden="true"></div>
    <div class="container relative under-bar">
      <div class="max-w-3xl">
        <span class="eyebrow">What I do</span>
        <h1 class="title-tech title-tech-lg mt-5">
          Services that build<br />
          <span class="text-primary-600 dark:text-primary-400">your online presence.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-ink-muted sm:text-xl">
          From a simple presentation site to a complex platform — plus everything your brand needs. Pick what you need or ask for a custom solution.
        </p>
        <p class="spec mt-8 border-t border-border pt-6">
          <span class="text-primary-600 dark:text-primary-400">5</span> services
          <span class="mx-2 text-ink-subtle" aria-hidden="true">/</span>
          quote within <span class="text-primary-600 dark:text-primary-400">24h</span>
          <span class="mx-2 text-ink-subtle" aria-hidden="true">/</span>
          <span class="text-primary-600 dark:text-primary-400">free</span> consultation
        </p>
      </div>
    </div>
  </section>

  <!-- Grouped services -->
  <Section>
    <div class="flex flex-col gap-16">
      {groups.map((group) => (
        <div>
          <div class="flex items-center gap-4">
            <h2 class="eyebrow !text-ink-subtle">{group.label}</h2>
            <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
          </div>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {group.services.map((s) => (
              <a
                href={s.href}
                class="group reveal brackets svc-card flex flex-col border border-border bg-surface-3 p-6 transition-[border-color,box-shadow] duration-300 hover:border-primary-400 hover:shadow-medium"
              >
                <span class="flex size-12 items-center justify-center rounded-xl bg-primary-500/12 text-primary-600 transition-transform duration-300 group-hover:scale-110 dark:text-primary-300" aria-hidden="true">
                  <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d={s.icon} />
                  </svg>
                </span>
                <h3 class="mt-5 font-heading text-xl font-bold text-ink">{s.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-muted">{s.description}</p>
                <ul class="mt-4 flex flex-col gap-2">
                  {s.features.map((f) => (
                    <li class="flex items-center gap-2 text-sm text-ink-muted">
                      <svg class="size-4 shrink-0 text-primary-600 dark:text-primary-300" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                      </svg>
                      {f}
                    </li>
                  ))}
                </ul>
                <span class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-semibold text-primary-600 dark:text-primary-300">
                  Learn more
                  <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- CTA -->
  <Section>
    <CtaSplit
      title="Not sure what you need?"
      subtitle="Tell me about your business and I will help you pick the right solution. The first consultation is free."
      primary="Get in touch for free"
      primaryHref={route('contact', 'en')}
      secondary="See the portfolio"
      secondaryHref={route('portfolio', 'en')}
    />
  </Section>
</BaseLayout>

<style>
  /* Lumină albă, nu aure colorate — aceeași decizie ca în hero-ul de pe home:
     banda e alb-negru, verdele trăiește pe secțiunile deschise. */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(46rem 26rem at 82% -20%, oklch(1 0 0 / 0.09), transparent 62%),
      radial-gradient(34rem 22rem at 4% 4%, oklch(1 0 0 / 0.05), transparent 58%);
  }

  /* Colțuri drepte, ca pe cardurile de pe home — colțurile în „L" cer muchie. */
  .svc-card { border-radius: var(--radius-sm); }
  .svc-card::after { opacity: 0.5; transition: opacity 0.3s var(--ease-out-expo); }
  .svc-card:hover::after { opacity: 1; }

</style>
