---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import PageHero from '@components/sections/PageHero.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import BlogList from '@components/sections/BlogList.astro';
import { getCollection } from 'astro:content';
import { getDict, route } from '@/i18n';

const dict = getDict('en');

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.data.lang === 'en')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

---

<BaseLayout
  title="Blog"
  description="Articles about web development, SEO, design and digital marketing. Practical advice for businesses in Moldova and Romania."
  heroOverlay
>
  <PageHero
    title={dict.breadcrumb.blog}
    subtitle="Practical articles about growing your business online. SEO, web development, design and digital marketing."
  />

  <Section>

    {posts.length === 0 ? (
      <p class="mt-10 text-center text-ink-muted">
        The first articles are coming soon. Check back!
      </p>
    ) : (
      <BlogList posts={posts} locale="en" blogHref={route('blog', 'en')} />
    )}
  </Section>
</BaseLayout>
