---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Badge from '@components/ui/Badge.astro';
import { getCollection } from 'astro:content';
import { getDict, route } from '@/i18n';

const dict = getDict('en');

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.data.lang === 'en')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Blog"
  description="Articles about web development, SEO, design and digital marketing. Practical advice for businesses in Moldova and Romania."
>
  <Section>
    <SectionHeading
      title={dict.breadcrumb.blog}
      subtitle="Practical articles about growing your business online. SEO, web development, design and digital marketing."
      as="h1"
    />

    {posts.length === 0 ? (
      <p class="mt-10 text-center text-ink-muted">
        The first articles are coming soon. Check back!
      </p>
    ) : (
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a
            href={`${route('blog', 'en')}/${post.id}`}
            class="group reveal flex flex-col overflow-hidden rounded-xl border border-border bg-surface-3 transition-all duration-300 hover:border-primary-200 hover:shadow-medium"
          >
            {post.data.image && (
              <div class="aspect-video overflow-hidden bg-surface-2">
                <img
                  src={post.data.image}
                  alt={post.data.imageAlt || post.data.title}
                  class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
            )}
            <div class="flex flex-1 flex-col p-5">
              <div class="flex flex-wrap gap-2">
                {post.data.tags.slice(0, 2).map((tag) => (
                  <Badge>{tag}</Badge>
                ))}
              </div>
              <h2 class="mt-3 font-heading text-lg font-bold text-ink group-hover:text-primary-700 dark:group-hover:text-primary-300">
                {post.data.title}
              </h2>
              <p class="mt-2 line-clamp-2 text-sm text-ink-muted">
                {post.data.description}
              </p>
              <time
                datetime={post.data.date.toISOString()}
                class="mt-auto pt-4 text-xs text-ink-subtle"
              >
                {formatDate(post.data.date)}
              </time>
            </div>
          </a>
        ))}
      </div>
    )}
  </Section>
</BaseLayout>
