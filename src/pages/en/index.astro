---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import ServicesBento from '@components/sections/ServicesBento.astro';
import WhyMe from '@components/sections/WhyMe.astro';
import FeaturedProjects from '@components/sections/FeaturedProjects.astro';
import Hero from '@components/sections/Hero.astro';
import CtaSplit from '@components/sections/CtaSplit.astro';
import SchemaLocalBusiness from '@components/seo/SchemaLocalBusiness.astro';
import SchemaFAQ from '@components/seo/SchemaFAQ.astro';
import { getDict, route } from '@/i18n';

const dict = getDict('en');

const faqs = [
  { q: 'How much does a website cost?', a: 'For a small business, a professional presentation website usually costs between €400 and €1,200, depending on the design, the number of pages and the features. I will send you an exact quote within 24 hours.' },
  { q: 'How long does it take to build?', a: 'A presentation website takes 1–3 weeks on average, depending on complexity and on how quickly I receive your content (copy and photos).' },
  { q: 'Custom code or WordPress — which one is right for me?', a: 'It depends on your needs: custom code for maximum speed and SEO, WordPress if you want to edit content yourself often. I will honestly recommend the option that fits you.' },
  { q: 'Do you also handle SEO?', a: 'Yes. Every website is built optimised for search engines and for speed — many of them reach a score of 100 on Google PageSpeed.' },
  { q: 'Do you only work in Chisinau?', a: 'I am based in Chisinau, but I work remotely with clients across Moldova, Romania and the rest of Europe. Everything can be done online.' },
];
---

<BaseLayout
  title="Web Developer in Chisinau — Freelance Website Development"
  description="Freelance web developer in Chisinau. I build fast, SEO-optimised websites with a PageSpeed score of 100 — no templates. Get a quote within 24 hours."
>
  <SchemaLocalBusiness />
  <!-- Editorial hero -->
  <Hero
    badge={dict.hero.badge}
    title="Websites that"
    titleHighlight="deliver results."
    subtitle={dict.hero.subtitle}
    ctaPrimary={dict.hero.ctaPrimary}
    ctaPrimaryHref={route('contact', 'en')}
    ctaSecondary={dict.hero.ctaSecondary}
    ctaSecondaryHref={route('portfolio', 'en')}
  />

  <!-- Services -->
  <Section background="muted">
    <SectionHeading
      eyebrow="What I do"
      title={dict.services.sectionTitle}
      subtitle={dict.services.sectionSubtitle}
    />
    <ServicesBento />
  </Section>

  <!-- Featured portfolio -->
  <Section>
    <FeaturedProjects />
  </Section>

  <!-- Why me -->
  <Section>
    <SectionHeading
      eyebrow="Why me"
      title={dict.whyMe.title}
      subtitle={dict.whyMe.subtitle}
      align="center"
    />
    <WhyMe />
  </Section>

  <!-- FAQ -->
  <Section background="muted">
    <SchemaFAQ items={faqs} />
    <SectionHeading
      eyebrow="Frequently asked questions"
      title="Frequently asked questions"
      align="center"
    />
    <div class="mx-auto mt-10 max-w-3xl divide-y divide-border">
      {faqs.map((f) => (
        <details class="faq reveal py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-lg font-bold text-ink">
            {f.q}
            <svg class="faq-chevron size-5 shrink-0 text-ink-subtle transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </summary>
          <p class="mt-3 text-ink-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </Section>

  <!-- CTA -->
  <Section>
    <CtaSplit
      title={dict.cta.title}
      subtitle={dict.cta.subtitle}
      primary={dict.cta.primary}
      primaryHref={route('contact', 'en')}
      secondary={dict.cta.secondary}
      secondaryHref={route('services', 'en')}
    />
  </Section>
</BaseLayout>

<style>
  .faq summary::-webkit-details-marker { display: none; }
  .faq[open] .faq-chevron { transform: rotate(180deg); }

  @media (prefers-reduced-motion: reduce) {
    .animate-ping { animation: none; }
  }
</style>
