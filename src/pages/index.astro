---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import ServiceCard from '@components/ui/ServiceCard.astro';
import Badge from '@components/ui/Badge.astro';
import Card from '@components/ui/Card.astro';
import FeaturedProjects from '@components/sections/FeaturedProjects.astro';
import PerfGauge from '@components/ui/PerfGauge.astro';
import SchemaLocalBusiness from '@components/seo/SchemaLocalBusiness.astro';
import SchemaFAQ from '@components/seo/SchemaFAQ.astro';

const faqs = [
  { q: 'Cât costă un site web?', a: 'Pentru o afacere mică, un site de prezentare profesional costă de obicei între €400 și €1.200, în funcție de design, numărul de pagini și funcții. Îți trimit o ofertă exactă în 24 de ore.' },
  { q: 'În cât timp e gata site-ul?', a: 'Un site de prezentare durează în medie 1–3 săptămâni, în funcție de complexitate și de cât de repede primesc conținutul (texte și poze).' },
  { q: 'Site în cod sau WordPress — ce alegi pentru mine?', a: 'Depinde de nevoile tale: cod pentru viteză și SEO maxim, WordPress dacă vrei să editezi singur conținutul des. Îți recomand sincer varianta care ți se potrivește.' },
  { q: 'Faci și optimizare SEO?', a: 'Da. Fiecare site e construit optimizat pentru motoarele de căutare și pentru viteză — multe ating scor 100 pe Google PageSpeed.' },
  { q: 'Lucrezi doar în Chișinău?', a: 'Sunt în Chișinău, dar lucrez la distanță cu clienți din toată Moldova și din România. Totul se poate face online.' },
];

const services = [
  {
    title: 'Site web în cod',
    description: 'Site-uri rapide, optimizate SEO, construite cu tehnologii moderne. Fără template-uri — fiecare proiect e unic.',
    href: '/servicii/creare-site-web',
  },
  {
    title: 'Site WordPress',
    description: 'Site-uri WordPress profesionale pe care le poți gestiona singur. Teme custom, nu page builders lente.',
    href: '/servicii/site-wordpress',
  },
  {
    title: 'Redesign site',
    description: 'Transformă un site vechi într-unul modern, rapid și care aduce clienți. Păstrăm ce funcționează, îmbunătățim restul.',
    href: '/servicii/redesign-site',
  },
  {
    title: 'Cărți de vizită',
    description: 'Design profesional care te face memorabil. Print-ready, livrare rapidă.',
    href: '/servicii/carti-de-vizita',
  },
  {
    title: 'Identitate vizuală',
    description: 'Logo, paletă de culori, tipografie — tot ce ai nevoie ca brandul tău să arate coerent și profesional.',
    href: '/servicii/identitate-vizuala',
  },
];
---

<BaseLayout
  title="Creare site web Chișinău — Web Developer Freelance"
  description="Web developer freelance în Chișinău. Creez site-uri web rapide, optimizate SEO, cu scor PageSpeed 100 — fără template-uri. Solicită o ofertă în 24h."
>
  <SchemaLocalBusiness />
  <!-- Hero editorial -->
  <section class="hero-shell relative overflow-hidden">
    <!-- Fundal decorativ: mesh gradient + grilă subtilă (pur CSS, aria-hidden) -->
    <div class="hero-bg grain" aria-hidden="true"></div>
    <div class="container relative py-section">
      <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
        <!-- Text -->
        <div class="max-w-2xl">
          <span class="eyebrow enter" style="--i: 0;">
            <span class="relative flex size-2">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-primary-500 opacity-60"></span>
              <span class="relative inline-flex size-2 rounded-full bg-primary-500"></span>
            </span>
            Disponibil pentru proiecte noi
          </span>
          <h1 class="enter mt-6 font-heading text-mega font-black leading-[0.95] text-ink" style="--i: 1;">
            Site-uri web care<br />
            <span class="ink-highlight text-primary-600 dark:text-primary-400">aduc rezultate.</span>
          </h1>
          <p class="enter mt-7 max-w-xl text-lg text-ink-muted sm:text-xl" style="--i: 2;">
            Web developer freelancer în Chișinău. Design modern, cod curat, performanță excelentă — site-ul tău merită mai mult decât un template.
          </p>
          <div class="enter mt-9 flex flex-wrap gap-3 sm:gap-4" style="--i: 3;">
            <Button href="/contact" variant="primary" size="lg">
              Solicită o ofertă
            </Button>
            <Button href="/portofoliu" variant="secondary" size="lg">
              Vezi portofoliul
            </Button>
          </div>
          <!-- Spec line — vocea de date a developerului -->
          <p class="spec enter mt-10 border-t border-border pt-6" style="--i: 4;">
            <span class="text-primary-600 dark:text-primary-400">20+</span> proiecte livrate
            <span class="mx-2 text-border-strong">/</span>
            răspuns în <span class="text-primary-600 dark:text-primary-400">24h</span>
            <span class="mx-2 text-border-strong">/</span>
            <span class="text-primary-600 dark:text-primary-400">zero</span> template-uri
          </p>
        </div>
        <!-- Semnătură: cadran de performanță -->
        <div class="enter justify-self-center" style="--i: 3;">
          <PerfGauge />
        </div>
      </div>
    </div>
  </section>

  <!-- Servicii -->
  <Section background="muted">
    <SectionHeading
      eyebrow="Ce fac"
      title="Servicii"
      subtitle="De la idee la un site care lucrează pentru tine. Alege ce ai nevoie."
    />
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <div class="reveal"><ServiceCard {...service} /></div>
      ))}
    </div>
  </Section>

  <!-- Portofoliu featured -->
  <Section>
    <FeaturedProjects />
  </Section>

  <!-- De ce eu -->
  <Section>
    <SectionHeading
      eyebrow="De ce eu"
      title="De ce să lucrezi cu mine"
      subtitle="Nu sunt o agenție cu 50 de oameni. Sunt o singură persoană care-ți dă toată atenția."
      align="center"
    />
    <div class="mx-auto mt-12 grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <div class="reveal">
        <Card hover>
          <div class="flex size-12 items-center justify-center rounded-xl bg-primary-500/12 text-primary-600 dark:text-primary-300" aria-hidden="true">
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
          </div>
          <h3 class="mt-4 font-heading text-xl font-bold text-ink">Rapid</h3>
          <p class="mt-2 text-sm text-ink-muted">
            Site-uri cu scor 95+ pe PageSpeed. Fiecare milisecundă contează pentru conversii și SEO.
          </p>
        </Card>
      </div>
      <div class="reveal">
        <Card hover>
          <div class="flex size-12 items-center justify-center rounded-xl bg-primary-500/12 text-primary-600 dark:text-primary-300" aria-hidden="true">
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
          </div>
          <h3 class="mt-4 font-heading text-xl font-bold text-ink">Focusat pe rezultate</h3>
          <p class="mt-2 text-sm text-ink-muted">
            Nu fac site-uri frumoase și atât. Fac site-uri care aduc clienți, vânzări și vizibilitate.
          </p>
        </Card>
      </div>
      <div class="reveal">
        <Card hover>
          <div class="flex size-12 items-center justify-center rounded-xl bg-primary-500/12 text-primary-600 dark:text-primary-300" aria-hidden="true">
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" />
            </svg>
          </div>
          <h3 class="mt-4 font-heading text-xl font-bold text-ink">Comunicare directă</h3>
          <p class="mt-2 text-sm text-ink-muted">
            Vorbești direct cu mine, nu cu un manager de proiect. Răspuns rapid, zero birocrație.
          </p>
        </Card>
      </div>
    </div>
  </Section>

  <!-- FAQ -->
  <Section background="muted">
    <SchemaFAQ items={faqs} />
    <SectionHeading
      eyebrow="Întrebări frecvente"
      title="Întrebări frecvente"
      align="center"
    />
    <div class="mx-auto mt-10 max-w-3xl divide-y divide-border">
      {faqs.map((f) => (
        <details class="faq reveal py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-lg font-bold text-ink">
            {f.q}
            <svg class="faq-chevron size-5 shrink-0 text-ink-subtle transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </summary>
          <p class="mt-3 text-ink-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </Section>

  <!-- CTA -->
  <Section>
    <div class="cta-panel grain reveal relative overflow-hidden rounded-3xl px-6 py-16 text-center sm:px-12 sm:py-20">
      <div class="relative mx-auto max-w-2xl">
        <h2 class="text-headline font-heading font-black text-white">
          Hai să construim ceva împreună
        </h2>
        <p class="mt-4 text-lg text-white/70">
          Spune-mi despre proiectul tău și îți trimit o ofertă personalizată în 24 de ore.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/contact" class="inline-flex items-center justify-center rounded-lg bg-white px-7 py-3.5 text-base font-semibold text-neutral-950 transition-transform duration-200 hover:-translate-y-0.5 sm:text-lg">
            Contactează-mă
          </a>
          <a href="/servicii" class="inline-flex items-center justify-center rounded-lg border border-white/25 px-7 py-3.5 text-base font-semibold text-white transition-colors duration-200 hover:bg-white/10 sm:text-lg">
            Vezi toate serviciile
          </a>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  /* Fundal hero — mesh gradient + grilă subtilă, pur CSS */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(50rem 30rem at 78% -10%, oklch(0.55 0.17 155 / 0.16), transparent 60%),
      radial-gradient(38rem 26rem at 8% 8%, oklch(0.65 0.20 30 / 0.10), transparent 55%);
  }
  .hero-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--color-hairline) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-hairline) 1px, transparent 1px);
    background-size: 4rem 4rem;
    mask-image: radial-gradient(60rem 40rem at 50% 0%, black, transparent 75%);
    opacity: 0.5;
  }

  /* Panou CTA — gradient editorial cu adâncime */
  .cta-panel {
    background:
      radial-gradient(40rem 20rem at 80% -20%, oklch(0.55 0.17 155 / 0.45), transparent 60%),
      radial-gradient(30rem 18rem at 10% 120%, oklch(0.65 0.20 30 / 0.30), transparent 60%),
      linear-gradient(135deg, oklch(0.27 0.08 155), oklch(0.14 0.02 160));
    box-shadow: var(--shadow-strong);
  }

  /* FAQ acordeon — zero JS */
  .faq summary::-webkit-details-marker { display: none; }
  .faq[open] .faq-chevron { transform: rotate(180deg); }

  /* Ping pentru badge disponibilitate */
  @media (prefers-reduced-motion: reduce) {
    .animate-ping { animation: none; }
  }
</style>
