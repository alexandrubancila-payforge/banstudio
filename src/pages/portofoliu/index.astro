---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import ProjectCard from '@components/ui/ProjectCard.astro';
import { getCollection } from 'astro:content';

const CATEGORIES = [
  {
    key: 'web',
    title: 'Site-uri web',
    subtitle: 'Site-uri de prezentare, magazine online și aplicații web.',
  },
  {
    key: 'carti-vizita',
    title: 'Cărți de vizită',
    subtitle: 'Design de cărți de vizită, gata de tipar.',
  },
];

const projects = (await getCollection('portofoliu'))
  .filter((p) => !('draft' in p.data && p.data.draft) && (p.data.lang === 'ro' || !p.data.lang))
  .sort((a, b) => {
    if (a.data.order !== b.data.order) return a.data.order - b.data.order;
    return b.data.date.getTime() - a.data.date.getTime();
  });

const groups = CATEGORIES
  .map((c) => ({ ...c, projects: projects.filter((p) => (p.data.category ?? 'web') === c.key) }))
  .filter((g) => g.projects.length > 0);
---

<BaseLayout
  title="Portofoliu"
  description="Proiecte web realizate pentru clienți din Moldova și România. Site-uri rapide, moderne și optimizate SEO."
>
  <Section>
    <SectionHeading
      title="Portofoliu"
      subtitle="Fiecare proiect e o poveste. Iată câteva dintre cele mai recente lucrări."
      as="h1"
    />

    {groups.map((group, i) => (
      <div class:list={[i === 0 ? 'mt-12' : 'mt-16']}>
        <div class="flex items-center gap-4">
          <h2 class="eyebrow !text-ink-subtle">{group.title}</h2>
          <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
        </div>

        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {group.projects.map((project) => (
            <ProjectCard
              href={`/portofoliu/${project.id}`}
              image={project.data.image}
              imageAlt={project.data.imageAlt}
              title={project.data.title}
              client={project.data.client}
              tags={project.data.tags}
            />
          ))}
        </div>
      </div>
    ))}
  </Section>
</BaseLayout>
