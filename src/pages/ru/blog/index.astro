---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import PageHero from '@components/sections/PageHero.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import BlogList from '@components/sections/BlogList.astro';
import { getCollection } from 'astro:content';
import { getDict } from '@/i18n';

const dict = getDict('ru');

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.data.lang === 'ru')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

---

<BaseLayout
  title={dict.breadcrumb.blog}
  description="Статьи о веб-разработке, SEO, дизайне и цифровом маркетинге. Практические советы для бизнеса в Молдове и Румынии."
  heroOverlay
>
  <PageHero
    title={dict.breadcrumb.blog}
    subtitle="Практические статьи о том, как развивать бизнес онлайн. SEO, веб-разработка, дизайн и цифровой маркетинг."
  />

  <Section>

    {posts.length === 0 ? (
      <p class="mt-10 text-center text-ink-muted">
        Первые статьи скоро появятся. Возвращайтесь!
      </p>
    ) : (
      <BlogList posts={posts} locale="ru" blogHref="/ru/blog" />
    )}
  </Section>
</BaseLayout>
