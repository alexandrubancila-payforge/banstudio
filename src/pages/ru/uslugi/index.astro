---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import ServiceCard from '@components/ui/ServiceCard.astro';
import CtaSplit from '@components/sections/CtaSplit.astro';
import { getDict } from '@/i18n';

const dict = getDict('ru');
const services = dict.services.items;
---

<BaseLayout
  title={dict.services.sectionTitle}
  description={dict.services.pageSubtitle}
>
  <Section>
    <SectionHeading
      title={dict.services.sectionTitle}
      subtitle={dict.services.pageSubtitle}
      as="h1"
    />
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <div class="reveal"><ServiceCard {...service} /></div>
      ))}
    </div>
  </Section>

  <Section>
    <CtaSplit
      title={dict.services.notSure}
      subtitle={dict.services.notSureDesc}
      primary={dict.services.notSureCta}
      primaryHref="/ru/kontakt"
      secondary={dict.hero.ctaSecondary}
      secondaryHref="/ru/portfolio"
    />
  </Section>
</BaseLayout>
