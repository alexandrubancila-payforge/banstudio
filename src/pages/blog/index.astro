---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import PageHero from '@components/sections/PageHero.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import BlogList from '@components/sections/BlogList.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && (p.data.lang === 'ro' || !p.data.lang))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

---

<BaseLayout
  title="Blog"
  description="Articole despre web development, SEO, design și marketing digital. Sfaturi practice pentru afaceri din Moldova și România."
  heroOverlay
>
  <PageHero
    title="Blog"
    subtitle="Articole practice despre cum să-ți crești afacerea online. SEO, web development, design și marketing digital."
  />

  <Section>

    {posts.length === 0 ? (
      <p class="mt-10 text-center text-ink-muted">
        Primele articole vin în curând. Revino!
      </p>
    ) : (
      <BlogList posts={posts} locale="ro" blogHref="/blog" />
    )}
  </Section>
</BaseLayout>
