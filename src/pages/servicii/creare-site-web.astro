---
import ServiceLayout from '@layouts/ServiceLayout.astro';
import Section from '@components/ui/Section.astro';
import Card from '@components/ui/Card.astro';
---

<ServiceLayout
  title="Creare site web"
  seoTitle="Creare site web în Chișinău și Moldova"
  description="Creare site web în Chișinău: site-uri profesionale construite în cod, design unic, performanță excelentă și SEO optimizat. Solicită o ofertă."
  badge="Serviciu principal"
>
  <Section>
    <h2 class="text-headline font-heading font-bold text-ink">Ce primești</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <Card hover class="reveal">
        <h3 class="font-heading text-lg font-bold text-ink">Design unic</h3>
        <p class="mt-2 text-sm text-ink-muted">
          Fiecare site e proiectat de la zero pentru afacerea ta. Fără template-uri generice — designul reflectă brandul tău.
        </p>
      </Card>
      <Card hover class="reveal">
        <h3 class="font-heading text-lg font-bold text-ink">Performanță 95+</h3>
        <p class="mt-2 text-sm text-ink-muted">
          Cod curat, imagini optimizate, zero bloat. Scor PageSpeed 95-100 pe mobil și desktop — Google te premiază.
        </p>
      </Card>
      <Card hover class="reveal">
        <h3 class="font-heading text-lg font-bold text-ink">SEO integrat</h3>
        <p class="mt-2 text-sm text-ink-muted">
          Meta tags, schema markup, sitemap, Core Web Vitals — totul e optimizat din start ca să fii găsit pe Google.
        </p>
      </Card>
      <Card hover class="reveal">
        <h3 class="font-heading text-lg font-bold text-ink">Responsive perfect</h3>
        <p class="mt-2 text-sm text-ink-muted">
          Site-ul arată impecabil pe telefon, tabletă și desktop. Mobile-first approach — pentru că 70%+ din trafic vine de pe mobil.
        </p>
      </Card>
      <Card hover class="reveal">
        <h3 class="font-heading text-lg font-bold text-ink">Securitate</h3>
        <p class="mt-2 text-sm text-ink-muted">
          Site static = zero vulnerabilități de server. HTTPS, headers de securitate, protecție completă.
        </p>
      </Card>
      <Card hover class="reveal">
        <h3 class="font-heading text-lg font-bold text-ink">Hosting inclus</h3>
        <p class="mt-2 text-sm text-ink-muted">
          Te ajut cu deploy-ul pe Cloudflare Pages sau Vercel — hosting rapid, gratuit, cu CDN global.
        </p>
      </Card>
    </div>
  </Section>

  <Section background="muted">
    <h2 class="text-headline font-heading font-bold text-ink">Procesul de lucru</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { step: '01', title: 'Descoperire', desc: 'Înțeleg afacerea ta, publicul țintă și obiectivele site-ului.' },
        { step: '02', title: 'Design', desc: 'Creez mockup-uri și le rafinăm împreună până sunt perfecte.' },
        { step: '03', title: 'Dezvoltare', desc: 'Construiesc site-ul în cod cu focus pe performanță și SEO.' },
        { step: '04', title: 'Lansare', desc: 'Testare finală, deploy, și suport post-lansare inclus.' },
      ].map(({ step, title, desc }) => (
        <div class="reveal">
          <span class="font-heading text-3xl font-black text-primary-500 dark:text-primary-300">{step}</span>
          <h3 class="mt-2 font-heading text-lg font-bold text-ink">{title}</h3>
          <p class="mt-2 text-sm text-ink-muted">{desc}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section>
    <h2 class="text-headline font-heading font-bold text-ink">Tehnologii pe care le folosesc</h2>
    <p class="mt-4 max-w-2xl text-ink-muted">
      Aleg tehnologia potrivită pentru fiecare proiect. Site de prezentare? Astro. Aplicație interactivă? Next.js. Landing page simplă? HTML/CSS pur.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      {['Astro', 'Next.js', 'TypeScript', 'Tailwind CSS', 'HTML/CSS', 'JavaScript', 'Cloudflare Pages', 'Vercel'].map((tech) => (
        <span class="reveal rounded-full border border-border bg-surface-3 px-4 py-2 text-sm font-medium text-ink-muted">
          {tech}
        </span>
      ))}
    </div>
  </Section>
</ServiceLayout>
