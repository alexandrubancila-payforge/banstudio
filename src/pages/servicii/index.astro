---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import CtaSplit from '@components/sections/CtaSplit.astro';

const groups = [
  {
    label: 'Dezvoltare web',
    services: [
      {
        title: 'Creare site web în cod',
        description: 'Site-uri rapide, optimizate SEO, construite cu tehnologii moderne. Fără template-uri — fiecare proiect e unic.',
        href: '/servicii/creare-site-web',
        icon: 'M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5',
        features: ['Design unic, fără template', 'Scor PageSpeed 100', 'Cod curat — Astro / Next.js'],
      },
      {
        title: 'Site WordPress',
        description: 'Site-uri WordPress profesionale cu teme custom, pe care le poți gestiona singur. Fără page builders lente.',
        href: '/servicii/site-wordpress',
        icon: 'M3 8.25V18a2.25 2.25 0 0 0 2.25 2.25h13.5A2.25 2.25 0 0 0 21 18V8.25m-18 0V6a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 6v2.25m-18 0h18',
        features: ['Temă custom, fără page builders', 'Îl administrezi singur ușor', 'Rapid și sigur'],
      },
      {
        title: 'Redesign site',
        description: 'Transformă un site vechi într-unul modern, rapid și care aduce clienți. Păstrăm ce funcționează, îmbunătățim restul.',
        href: '/servicii/redesign-site',
        icon: 'M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.182 3.182a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99',
        features: ['Modernizare completă', 'Păstrăm ce funcționează', 'Mai rapid, mai multe conversii'],
      },
    ],
  },
  {
    label: 'Design & brand',
    services: [
      {
        title: 'Cărți de vizită',
        description: 'Design profesional care te face memorabil. Print-ready, livrare rapidă, multiple variante de ales.',
        href: '/servicii/carti-de-vizita',
        icon: 'M6 6.878V6a2.25 2.25 0 0 1 2.25-2.25h7.5A2.25 2.25 0 0 1 18 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 0 0 4.5 9v.878m13.5-3A2.25 2.25 0 0 1 19.5 9v.878m0 0a2.246 2.246 0 0 0-.75-.128H5.25c-.263 0-.515.045-.75.128m15 0A2.25 2.25 0 0 1 21 12v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6c0-.98.626-1.813 1.5-2.122',
        features: ['Design memorabil', 'Print-ready', 'Mai multe variante'],
      },
      {
        title: 'Identitate vizuală',
        description: 'Logo, paletă de culori, tipografie, ghid de brand — tot ce ai nevoie ca brandul tău să arate coerent și profesional.',
        href: '/servicii/identitate-vizuala',
        icon: 'M4.098 19.902a3.75 3.75 0 0 0 5.304 0l6.401-6.402M6.75 21A3.75 3.75 0 0 1 3 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 0 0 3.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125H10.5',
        features: ['Logo + paletă + tipografie', 'Ghid de brand', 'Coerență pe toate canalele'],
      },
    ],
  },
];
---

<BaseLayout
  title="Servicii web — creare site, WordPress, redesign | Ban Studio"
  description="Servicii profesionale de web development și design în Chișinău: creare site-uri, WordPress, redesign, cărți de vizită, identitate vizuală. Ofertă în 24h."
>
  <!-- Hero -->
  <section class="rails relative overflow-hidden">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container relative pb-section pt-16 sm:pt-20">
      <div class="max-w-3xl">
        <span class="eyebrow">Ce fac</span>
        <h1 class="mt-5 font-heading text-display font-black leading-[0.95] text-ink">
          Servicii care-ți<br />
          <span class="text-primary-600 dark:text-primary-400">construiesc prezența online.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-ink-muted sm:text-xl">
          De la un site simplu de prezentare la o platformă complexă — plus tot ce ține de brand. Alege ce ai nevoie sau cere o soluție personalizată.
        </p>
        <p class="spec mt-8 border-t border-border pt-6">
          <span class="text-primary-600 dark:text-primary-400">5</span> servicii
          <span class="mx-2 text-border-strong">/</span>
          ofertă în <span class="text-primary-600 dark:text-primary-400">24h</span>
          <span class="mx-2 text-border-strong">/</span>
          consultanță <span class="text-primary-600 dark:text-primary-400">gratuită</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Servicii grupate -->
  <Section>
    <div class="flex flex-col gap-16">
      {groups.map((group) => (
        <div>
          <div class="flex items-center gap-4">
            <h2 class="eyebrow !text-ink-subtle">{group.label}</h2>
            <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
          </div>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {group.services.map((s) => (
              <a
                href={s.href}
                class="group reveal flex flex-col rounded-2xl border border-border bg-surface-3 p-6 transition-[border-color,box-shadow] duration-300 hover:border-primary-400 hover:shadow-medium"
              >
                <span class="flex size-12 items-center justify-center rounded-xl bg-primary-500/12 text-primary-600 transition-transform duration-300 group-hover:scale-110 dark:text-primary-300" aria-hidden="true">
                  <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d={s.icon} />
                  </svg>
                </span>
                <h3 class="mt-5 font-heading text-xl font-bold text-ink">{s.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-muted">{s.description}</p>
                <ul class="mt-4 flex flex-col gap-2">
                  {s.features.map((f) => (
                    <li class="flex items-center gap-2 text-sm text-ink-muted">
                      <svg class="size-4 shrink-0 text-primary-600 dark:text-primary-300" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                      </svg>
                      {f}
                    </li>
                  ))}
                </ul>
                <span class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-semibold text-primary-600 dark:text-primary-300">
                  Află mai multe
                  <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- CTA -->
  <Section>
    <CtaSplit
      title="Nu ești sigur ce ai nevoie?"
      subtitle="Spune-mi despre afacerea ta și te ajut să alegi soluția potrivită. Consultanța inițială e gratuită."
      primary="Contactează-mă gratuit"
      primaryHref="/contact"
      secondary="Vezi portofoliul"
      secondaryHref="/portofoliu"
    />
  </Section>
</BaseLayout>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(46rem 26rem at 82% -20%, oklch(0.55 0.17 155 / 0.14), transparent 60%),
      radial-gradient(34rem 22rem at 4% 4%, oklch(0.65 0.20 30 / 0.09), transparent 55%);
  }
  .hero-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--color-rail) 1px, transparent 1px);
    background-size: 1.375rem 1.375rem;
    mask-image: radial-gradient(50rem 32rem at 30% 0%, black, transparent 75%);
    opacity: 0.5;
  }
</style>
