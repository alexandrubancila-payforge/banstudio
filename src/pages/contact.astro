---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import PageHero from '@components/sections/PageHero.astro';
import { SITE, SOCIAL_LINKS } from '@lib/constants';
---

<BaseLayout
  title="Contact"
  description="Contactează-mă pentru o ofertă personalizată. Consultanța inițială e gratuită. Răspund în maximum 24 de ore."
  heroOverlay
>
  <PageHero
    title="Contactează-mă"
    subtitle="Ai un proiect în minte? Spune-mi despre el și îți trimit o ofertă personalizată în 24 de ore. Consultanța inițială e gratuită."
  />

  <Section>
    <div class="grid gap-12 lg:grid-cols-5">
      <!-- Info contact -->
      <div class="lg:col-span-2">

        <div class="space-y-5">
          <div class="reveal flex items-start gap-3">
            <span class="mt-0.5 text-primary-600 dark:text-primary-300">
              <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
              </svg>
            </span>
            <div>
              <p class="text-sm font-medium text-ink-subtle">Email</p>
              <a href="mailto:sasa.bancila@gmail.com" class="text-ink-muted hover:text-primary-600">
                sasa.bancila@gmail.com
              </a>
            </div>
          </div>

          <div class="reveal flex items-start gap-3">
            <span class="mt-0.5 text-primary-600 dark:text-primary-300">
              <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0 1 15 0Z" />
              </svg>
            </span>
            <div>
              <p class="text-sm font-medium text-ink-subtle">Locație</p>
              <p class="text-ink-muted">Chișinău, Moldova</p>
            </div>
          </div>

          <div class="reveal flex items-start gap-3">
            <span class="mt-0.5 text-primary-600 dark:text-primary-300">
              <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
              </svg>
            </span>
            <div>
              <p class="text-sm font-medium text-ink-subtle">Telefon</p>
              <a href="tel:+37369456448" class="text-ink-muted hover:text-primary-600">
                069 456 448
              </a>
            </div>
          </div>

          <div class="reveal flex items-start gap-3">
            <span class="mt-0.5 text-primary-600 dark:text-primary-300">
              <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
            </span>
            <div>
              <p class="text-sm font-medium text-ink-subtle">Timp de răspuns</p>
              <p class="text-ink-muted">Maximum 24 de ore</p>
            </div>
          </div>
        </div>

        <!-- Mesagerii -->
        <div class="mt-8">
          <p class="text-sm font-medium text-ink-subtle">Scrie-mi direct</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <a
              href="https://t.me/bancilaalexandru"
              target="_blank"
              rel="noopener noreferrer"
              class="reveal inline-flex items-center gap-2 rounded-lg border border-border px-3 py-2 text-sm text-ink-muted transition-colors hover:bg-surface-2 hover:text-ink"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
              </svg>
              Telegram
            </a>
            <a
              href="https://wa.me/37369456448"
              target="_blank"
              rel="noopener noreferrer"
              class="reveal inline-flex items-center gap-2 rounded-lg border border-border px-3 py-2 text-sm text-ink-muted transition-colors hover:bg-surface-2 hover:text-ink"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
              </svg>
              WhatsApp
            </a>
            <a
              href="viber://chat?number=37369456448"
              class="reveal inline-flex items-center gap-2 rounded-lg border border-border px-3 py-2 text-sm text-ink-muted transition-colors hover:bg-surface-2 hover:text-ink"
            >
              <svg class="size-4" viewBox="0 0 512 512" fill="currentColor">
                <path d="M444 49.9C431.3 38.2 379.9.9 265.3.4c0 0-135.1-8.1-200.9 52.3C27.8 89.3 14.9 143 13.5 209.5c-1.4 66.5-3.1 191.1 117 224.9h.1l-.1 51.6s-.8 20.9 13 25.1c16.6 5.2 26.4-10.7 42.3-27.8 8.7-9.4 20.7-23.2 29.8-33.7 82.2 6.9 145.3-8.9 152.5-11.2 16.6-5.4 110.5-17.4 125.7-142 15.8-128.6-7.6-209.8-49.8-246.5zM457.9 287c-12.9 104-89 110.6-103 115.1-6 1.9-61.5 15.7-131.2 11.2 0 0-52 62.7-68.2 79-5.3 5.3-11.1 4.8-11-5.7 0-6.9.4-85.7.4-85.7-.1 0-.1 0 0 0-101.8-28.2-95.8-134.3-94.7-189.8 1.1-55.5 11.6-101 42.6-131.6 55.7-50.5 170.4-43 170.4-43 96.9.4 143.3 29.6 154.1 39.4 35.7 30.6 53.9 103.8 40.6 211.1zm-139-80.8c.4 8.6-12.5 9.2-12.9.6-1.1-22-11.4-32.7-32.6-33.9-8.6-.5-7.8-13.4.7-12.9 27.9 1.5 43.4 17.5 44.8 46.2zm20.3 11.3c1-42.4-25.5-75.6-75.8-79.3-8.5-.6-7.6-13.5.9-12.9 58 4.2 88.9 44.1 87.8 92.5-.1 8.6-13.1 8.2-12.9-.3zm47 13.4c.1 8.6-12.9 8.7-12.9.1-.6-81.5-54.9-125.9-120.8-126.4-8.5-.1-8.5-12.9 0-12.9 73.7.5 133 51.4 133.7 139.2zM374.9 329v.2c-10.8 19-31 40-51.8 33.3l-.2-.3c-21.1-5.9-70.8-31.5-102.2-56.5-16.2-12.8-31-27.9-42.4-42.4-10.3-12.9-20.7-28.2-30.8-46.6-21.3-38.5-26-55.7-26-55.7-6.7-20.8 14.2-41 33.3-51.8h.2c9.2-4.8 18-3.2 23.9 3.9 0 0 12.4 14.8 17.7 22.1 5 6.8 11.7 17.7 15.2 23.8 6.1 10.9 2.3 22-3.7 26.6l-12 9.6c-6.1 4.9-5.3 14-5.3 14s17.8 67.3 84.3 84.3c0 0 9.1.8 14-5.3l9.6-12c4.6-6 15.7-9.8 26.6-3.7 14.7 8.3 33.4 21.2 45.8 32.9 7 5.7 8.6 14.4 3.8 23.6z"/>
              </svg>
              Viber
            </a>
          </div>
        </div>

        <!-- Social -->
        <div class="mt-6 flex gap-3">
          <a
            href={SOCIAL_LINKS.github}
            target="_blank"
            rel="noopener noreferrer"
            class="reveal flex size-10 items-center justify-center rounded-lg border border-border text-ink-muted transition-colors hover:bg-surface-2 hover:text-ink"
            aria-label="GitHub"
          >
            <svg class="size-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
            </svg>
          </a>
          <a
            href={SOCIAL_LINKS.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="reveal flex size-10 items-center justify-center rounded-lg border border-border text-ink-muted transition-colors hover:bg-surface-2 hover:text-ink"
            aria-label="LinkedIn"
          >
            <svg class="size-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Formular -->
      <div class="lg:col-span-3">
        <!-- Succes / Eroare mesaj — apare deasupra formularului -->
        <div id="form-success" class="mb-4 hidden rounded-lg bg-green-50 p-4 text-sm text-green-700">
          Mulțumesc! Mesajul tău a fost trimis. Te contactez în maximum 24 de ore.
        </div>
        <div id="form-error" class="mb-4 hidden rounded-lg bg-red-50 p-4 text-sm text-red-700">
          A apărut o eroare. Te rog trimite un email direct la sasa.bancila@gmail.com.
        </div>
        <form
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="rounded-xl border border-border bg-surface-3 p-6 sm:p-8"
        >
          <input type="hidden" name="access_key" value="20771192-8362-4b6f-a06f-b8ba73c5dad9" />
          <input type="hidden" name="subject" value="Cerere nouă de pe banstudio.dev" />
          <input type="hidden" name="from_name" value="Ban Studio Contact Form" />
          <input type="checkbox" name="botcheck" class="hidden" />

          <div class="space-y-5">
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class="block text-sm font-medium text-ink-muted">
                  Nume complet *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  autocomplete="name"
                  class="mt-1.5 w-full rounded-lg border border-border-strong bg-surface-3 px-4 py-2.5 text-ink transition-colors placeholder:text-ink-subtle focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20"
                  placeholder="Ion Popescu"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-ink-muted">
                  Email *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                  class="mt-1.5 w-full rounded-lg border border-border-strong bg-surface-3 px-4 py-2.5 text-ink transition-colors placeholder:text-ink-subtle focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20"
                  placeholder="ion@exemplu.md"
                />
              </div>
            </div>

            <div>
              <label for="phone" class="block text-sm font-medium text-ink-muted">
                Telefon
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                autocomplete="tel"
                class="mt-1.5 w-full rounded-lg border border-border-strong bg-surface-3 px-4 py-2.5 text-ink transition-colors placeholder:text-ink-subtle focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20"
                placeholder="+373 69 123 456"
              />
            </div>

            <div>
              <label for="service" class="block text-sm font-medium text-ink-muted">
                Ce serviciu te interesează?
              </label>
              <select
                id="service"
                name="service"
                class="mt-1.5 w-full rounded-lg border border-border-strong bg-surface-3 px-4 py-2.5 text-ink transition-colors focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20"
              >
                <option value="">Alege un serviciu...</option>
                <option value="creare-site-web">Creare site web în cod</option>
                <option value="site-wordpress">Site WordPress</option>
                <option value="redesign-site">Redesign site existent</option>
                <option value="carti-de-vizita">Cărți de vizită</option>
                <option value="identitate-vizuala">Identitate vizuală</option>
                <option value="altceva">Altceva</option>
              </select>
            </div>

            <div>
              <label for="budget" class="block text-sm font-medium text-ink-muted">
                Buget estimativ
              </label>
              <select
                id="budget"
                name="budget"
                class="mt-1.5 w-full rounded-lg border border-border-strong bg-surface-3 px-4 py-2.5 text-ink transition-colors focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20"
              >
                <option value="">Selectează...</option>
                <option value="sub-500">Sub 500 €</option>
                <option value="500-1000">500 – 1.000 €</option>
                <option value="1000-2000">1.000 – 2.000 €</option>
                <option value="peste-2000">Peste 2.000 €</option>
                <option value="nu-stiu">Nu sunt sigur</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-ink-muted">
                Mesaj *
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="mt-1.5 w-full resize-y rounded-lg border border-border-strong bg-surface-3 px-4 py-2.5 text-ink transition-colors placeholder:text-ink-subtle focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20"
                placeholder="Descrie pe scurt proiectul tău — ce fel de site ai nevoie, pentru ce afacere, ce funcționalități..."
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full rounded-lg bg-primary-600 px-6 py-3 font-medium text-white transition-colors hover:bg-primary-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 sm:w-auto"
            >
              Trimite mesajul
            </button>
          </div>
        </form>

      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successEl = document.getElementById('form-success')!;
  const errorEl = document.getElementById('form-error')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = submitBtn.textContent;
    submitBtn.textContent = 'Se trimite...';
    submitBtn.disabled = true;

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
      });

      if (res.ok) {
        form.reset();
        errorEl.classList.add('hidden');
        successEl.classList.remove('hidden');
        successEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        throw new Error('Submit failed');
      }
    } catch {
      successEl.classList.add('hidden');
      errorEl.classList.remove('hidden');
    } finally {
      submitBtn.textContent = originalText;
      submitBtn.disabled = false;
    }
  });
</script>
