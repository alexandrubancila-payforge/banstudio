---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import Badge from '@components/ui/Badge.astro';
import Section from '@components/ui/Section.astro';
import SchemaService from '@components/seo/SchemaService.astro';
import SchemaBreadcrumb from '@components/seo/SchemaBreadcrumb.astro';
import { resolveLocale, getDict, route } from '@/i18n';
import { routePath } from '@lib/paths';

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  badge: string;
  icon?: string;
}

const { title, seoTitle, description, badge } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const dict = getDict(locale);
const homeHref = route('home', locale);
const servicesHref = route('services', locale);
const contactHref = route('contact', locale);
const portfolioHref = route('portfolio', locale);
---

<BaseLayout title={seoTitle ?? title} description={description} heroOverlay>
  <SchemaService name={title} description={description} url={routePath(Astro.url)} />
  <SchemaBreadcrumb items={[
    { name: dict.breadcrumb.home, href: homeHref },
    { name: dict.breadcrumb.services, href: servicesHref },
    { name: title, href: routePath(Astro.url) },
  ]} />
  <!-- Hero serviciu — aceeași bandă întunecată ca pe home, sub bara transparentă -->
  <section class="rails on-dark under-bar">
    <div class="tech-grid" aria-hidden="true"></div>
    <div class="container">
      <nav class="service-crumbs" aria-label="Breadcrumb">
        <a href={homeHref}>{dict.breadcrumb.home}</a>
        <span aria-hidden="true">/</span>
        <a href={servicesHref}>{dict.breadcrumb.services}</a>
        <span aria-hidden="true">/</span>
        <span class="is-current">{title}</span>
      </nav>

      <Badge variant="primary">{badge}</Badge>
      <h1 class="title-tech title-tech-lg mt-5">
        {title}
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-muted sm:text-xl">
        {description}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={contactHref} variant="primary" size="lg">
          {dict.serviceLayout.requestOffer}
        </Button>
        <Button href={portfolioHref} variant="secondary">
          {dict.serviceLayout.viewExamples}
        </Button>
      </div>
    </div>
  </section>

  <!-- Conținut specific serviciu -->
  <slot />

  <!-- CTA final -->
  <Section background="dark" grid>
    <div class="brackets mx-auto max-w-2xl px-6 py-10 text-center sm:px-10">
      <h2 class="title-tech">
        {dict.serviceLayout.ctaTitle}
      </h2>
      <p class="mt-4 text-lg text-ink-muted">
        {dict.serviceLayout.ctaSubtitle}
      </p>
      <div class="mt-8">
        <Button href={contactHref} variant="primary" size="lg">
          {dict.serviceLayout.ctaButton}
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  /* Firimiturile — voce mono, ca etichetele tehnice din hero */
  .service-crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-subtle);
  }
  .service-crumbs a { color: var(--color-ink-muted); transition: color 0.2s; }
  .service-crumbs a:hover { color: var(--color-ink); }
  .service-crumbs .is-current { color: var(--color-ink); }
</style>
