---
import '@/styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { resolveLocale, getSiteConfig, getTranslatedPath, LOCALES } from '@/i18n';
import { routePath } from '@lib/paths';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Prima secțiune e hero-ul întunecat → headerul plutește peste ea. */
  heroOverlay?: boolean;
}

const locale = resolveLocale(Astro.currentLocale);
const site = getSiteConfig(locale);

const {
  title,
  description = site.description,
  ogImage = '/og-default.png',
  noindex = false,
  heroOverlay = false,
} = Astro.props;

const canonicalURL = new URL(routePath(Astro.url), site.url);
const fullTitle = title === 'Home' ? `${site.name} — ${description}` : `${title} | ${site.name}`;

// Hreflang alternate URLs — doar traduceri care există cu adevărat.
// getTranslatedPath întoarce null când nu există pereche 1:1; într-un asemenea caz
// NU emitem adnotarea, pentru că un hreflang care indică un 404 e ignorat de Google
// pentru toată perechea de pagini.
const currentPath = routePath(Astro.url);
const alternates = LOCALES.map((l) => {
  const path = l === locale ? currentPath : getTranslatedPath(currentPath, l);
  return { hreflang: l, url: path ? new URL(path, site.url) : null };
}).filter((a): a is { hreflang: typeof LOCALES[number]; url: URL } => a.url !== null);

// x-default = româna, limba implicită a site-ului.
const defaultURL = alternates.find((a) => a.hreflang === 'ro')?.url ?? null;
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Theme init — rulează înainte de paint, fără FOUC -->
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>

    <!-- Preload fonturi critice (heading + body latin) -->
    <link rel="preload" href="/fonts/satoshi-900.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    {/* Titlul hero-ului e elementul LCP — fără preload s-ar picta întâi cu
        fontul de rezervă și abia apoi ar schimba, mutând LCP mai târziu.
        Pe /ru titlul e chirilic, deci se preîncarcă fișierul chirilic: altfel
        preîncărcam 10 KB de latine care nu se folosesc acolo, iar litera de care
        pagina are nevoie ajungea abia după primul paint. */}
    {heroOverlay && (
      <link
        rel="preload"
        href={locale === 'ru' ? '/fonts/unbounded-700-cyrillic.woff2' : '/fonts/syncopate-700-latin.woff2'}
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}

    <!-- SEO -->
    <meta name="msvalidate.01" content="2D2B9DE7912774378FBD3360724A8AF5" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Hreflang -->
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.url} />)}
    {defaultURL && <link rel="alternate" hreflang="x-default" href={defaultURL} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, site.url)} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, site.url)} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />

    <slot name="head" />

    <!-- Google tag (gtag.js) — încărcat leneș, ca să nu blocheze randarea.
         Se încarcă la prima interacțiune SAU după 3s (în timp idle), oricare vine prima.
         Doar pe interacțiune nu era suficient: pe mobil nu există `mousemove`, deci un
         vizitator care intra, citea hero-ul și pleca fără să dea scroll nu ajungea
         NICIODATĂ în GA — de aici vizualizările artificial mici. Pentru bounce-urile
         de sub 3s, gtag.js nu se mai poate încărca la timp, așa că trimitem page_view
         direct prin Measurement Protocol cu sendBeacon, care pleacă și în timpul
         descărcării paginii. Cele două căi se exclud reciproc, deci nu se dublează. -->
    <script is:inline>
      (() => {
        var GA_ID = 'G-GK39DSP1PS';
        var loaded = false;
        var beaconSent = false;
        var timer;

        function loadGA() {
          if (loaded) return; loaded = true;
          clearTimeout(timer);
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function(){ dataLayer.push(arguments); };
          gtag('js', new Date());
          // Dacă beacon-ul a raportat deja vizita, nu mai trimitem al doilea page_view.
          gtag('config', GA_ID, { send_page_view: !beaconSent });
        }

        function store(api, key, make) {
          try {
            var v = window[api].getItem(key);
            if (!v) { v = make(); window[api].setItem(key, v); return { value: v, fresh: true }; }
            return { value: v, fresh: false };
          } catch (e) {
            return { value: make(), fresh: true };
          }
        }

        // client_id: refolosim cel din cookie-ul _ga dacă GA a rulat deja pentru acest
        // vizitator, ca să nu-l numărăm ca doi utilizatori diferiți.
        function clientId() {
          var m = document.cookie.match(/_ga=GA\d\.\d\.(\d+\.\d+)/);
          if (m) return m[1];
          return store('localStorage', 'ga_cid', function () {
            return Math.floor(Math.random() * 1e10) + '.' + Math.floor(Date.now() / 1000);
          }).value;
        }

        function beaconPageView() {
          if (loaded || beaconSent || !navigator.sendBeacon) return;
          beaconSent = true;
          var session = store('sessionStorage', 'ga_sid', function () {
            return String(Math.floor(Date.now() / 1000));
          });
          var p = new URLSearchParams({
            v: '2',
            tid: GA_ID,
            cid: clientId(),
            sid: session.value,
            en: 'page_view',
            dl: location.href,
            dt: document.title,
            ul: navigator.language,
            sr: screen.width + 'x' + screen.height,
            _p: String(Math.floor(Math.random() * 1e9)),
          });
          if (document.referrer) p.set('dr', document.referrer);
          if (session.fresh) p.set('_ss', '1');
          navigator.sendBeacon('https://www.google-analytics.com/g/collect?' + p.toString());
        }

        var evts = ['scroll', 'pointerdown', 'keydown', 'touchstart', 'mousemove'];
        function onFirst() { evts.forEach(function(e){ removeEventListener(e, onFirst); }); loadGA(); }
        evts.forEach(function(e){ addEventListener(e, onFirst, { once: true, passive: true }); });

        // Fallback pe timer, programat în timp idle ca să nu concureze cu randarea.
        timer = setTimeout(function () {
          if ('requestIdleCallback' in window) requestIdleCallback(loadGA, { timeout: 1000 });
          else loadGA();
        }, 3000);

        addEventListener('pagehide', beaconPageView);
        addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'hidden') beaconPageView();
        });
      })();
    </script>
  </head>
  <body class="min-h-dvh flex flex-col antialiased">
    <Header overlay={heroOverlay} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
