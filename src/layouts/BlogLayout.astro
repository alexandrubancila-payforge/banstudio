---
import BaseLayout from '@layouts/BaseLayout.astro';
import Badge from '@components/ui/Badge.astro';
import Button from '@components/ui/Button.astro';
import SchemaArticle from '@components/seo/SchemaArticle.astro';
import SchemaBreadcrumb from '@components/seo/SchemaBreadcrumb.astro';
import { routePath } from '@lib/paths';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  image?: string;
  imageAlt?: string;
  /** Timp de citire (minute), calculat de pagină din corpul markdown. */
  minutes?: number;
}

const { title, description, date, updated, tags = [], image, imageAlt, minutes } = Astro.props;

const formatDate = (d: Date) =>
  d.toLocaleDateString('ro-RO', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description} ogImage={image}>
  <SchemaArticle
    title={title}
    description={description}
    date={date}
    updated={updated}
    image={image}
    url={routePath(Astro.url)}
  />
  <SchemaBreadcrumb items={[
    { name: 'Acasă', href: '/' },
    { name: 'Blog', href: '/blog' },
    { name: title, href: routePath(Astro.url) },
  ]} />
  <article class="rails pb-section pt-10 sm:pt-14">
    <div class="container">
      <div class="mx-auto max-w-3xl">
        <nav class="text-sm text-ink-subtle" aria-label="Breadcrumb">
          <a href="/" class="transition-colors hover:text-ink">Acasă</a>
          <span class="mx-1.5 text-ink-subtle" aria-hidden="true">/</span>
          <a href="/blog" class="transition-colors hover:text-ink">Blog</a>
        </nav>

        {tags.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <Badge variant="primary">{tag}</Badge>
            ))}
          </div>
        )}

        <h1 class="mt-4 text-display font-heading font-black text-ink">
          {title}
        </h1>

        <p class="mt-4 text-lg text-ink-muted">
          {description}
        </p>

        <!-- Autor + dată -->
        <div class="mt-8 flex items-center gap-3 border-t border-border pt-6">
          <span class="grid size-10 shrink-0 place-items-center rounded-full bg-primary-600 font-heading text-base font-black text-white" aria-hidden="true">B</span>
          <div class="text-sm leading-tight">
            <p class="font-semibold text-ink">Alexandru Bancilă</p>
            <p class="mt-0.5 text-ink-subtle">
              <time datetime={date.toISOString()}>{formatDate(date)}</time>
              {minutes && <span> · {minutes} min de citit</span>}
              {updated && (<span> · actualizat <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span>)}
            </p>
          </div>
        </div>

        {image && (
          <div class="mt-8 overflow-hidden rounded-xl">
            <img
              src={image}
              alt={imageAlt || title}
              class="w-full object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
        )}

        <div class="prose mt-10">
          <slot />
        </div>

        <div class="mt-16 border-t border-border pt-8">
          <div class="rounded-xl bg-primary-50 dark:bg-primary-500/10 p-6 text-center sm:p-8">
            <h2 class="font-heading text-xl font-bold text-ink">
              Ai nevoie de un site profesional?
            </h2>
            <p class="mt-2 text-sm text-ink-muted">
              Contactează-mă pentru o consultanță gratuită despre proiectul tău.
            </p>
            <div class="mt-4">
              <Button href="/contact" variant="primary">
                Contactează-mă
              </Button>
            </div>
          </div>
        </div>

        <div class="mt-8 text-center">
          <Button href="/blog" variant="ghost">
            ← Toate articolele
          </Button>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
